import pytest
from playwright.sync_api import Page, expect
from src.base.base_test import BaseTest
from src.common.logger import logger

class TestVerifyChildProduct(BaseTest):
    """
    用例名：verify_child_product
    用例ms的id：0
    """

    def test_verify_child_product(self, page: Page, project_name: str):
        f"""测试物料清单添加子产品功能
        用例名：verify_child_product
        用例ms的id：0
        项目名：{project_name}

        Args:
            page: 页面实例
            project_name: 项目名称
        """
        logger.info("=" * 60)
        logger.info(f"开始执行用例：verify_child_product")
        logger.info(f"用例ms的id：0")
        logger.info("=" * 60)
        
        # 使用封装好的公用登录方法完成登录
        self.login(page, project_name)
        
        # 导航到物料清单页面
        logger.info("导航到基础资料->物料清单页面")
        page.get_by_text("基础资料").click()
        page.get_by_text("物料清单").click()
        
        # 提取复用iframe节点，减少重复定位
        bom_iframe = page.locator("iframe[name=\"supos-tab-framework-2\"]").content_frame
        logger.info("获取物料清单业务iframe成功")
        
        # 验证目标物料行返回功能
        logger.info("验证目标物料的返回功能")
        bom_iframe.get_by_role("cell", name="CP2026042300002").nth(3).click()
        bom_iframe.get_by_role("button", name="返 回").click()
        expect(bom_iframe.get_by_text("CP2026042300002").nth(3)).to_be_visible()
        expect(bom_iframe.locator(".ant-table-cell.ant-table-cell-fix-right.ant-table-cell-fix-right-first.ant-table-cell-row-hover > .ant-menu-overflow > li > .ant-menu-title-content > .edit-btn")).to_be_visible()
        
        # 进入编辑，添加子产品
        logger.info("点击编辑按钮，开始添加子项产品")
        bom_iframe.locator(".ant-menu-overflow-item.ant-menu-item.ant-menu-item-active > .ant-menu-title-content > .edit-btn").click()
        bom_iframe.get_by_role("button", name="plus-circle 添加子项产品").click()
        bom_iframe.locator(".tree-layout > .list-layout > .table-wrapper").click()
        bom_iframe.locator(".ant-table-cell.ant-table-selection-column.ant-table-cell-fix-left.ant-table-cell-row-hover").click()
        bom_iframe.get_by_role("button", name="选 择").click()
        
        # 保存选中的子产品
        logger.info("确认选择后保存")
        bom_iframe.get_by_role("button", name="保 存").click()
        
        # 修改子产品用量后保存
        logger.info("修改子产品用量，再次保存")
        bom_iframe.get_by_role("button", name="holder 4 CP2026042300008").get_by_role("spinbutton").click()
        bom_iframe.get_by_role("button", name="保 存").click()
        
        # 取消编辑返回列表
        logger.info("取消编辑，返回物料清单列表")
        bom_iframe.get_by_role("button", name="取 消").click()
        
        # 二次操作验证流程正确性
        logger.info("二次验证操作流程")
        bom_iframe.get_by_role("cell", name="CP2026042300002").nth(3).click()
        bom_iframe.get_by_role("button", name="返 回").click()
        bom_iframe.locator(".ant-menu-overflow-item.ant-menu-item.ant-menu-item-active > .ant-menu-title-content > .edit-btn").click()
        bom_iframe.get_by_role("button", name="取 消").click()
        
        logger.info("用例verify_child_product执行完成")
