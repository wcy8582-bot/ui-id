from playwright.sync_api import Playwright, sync_playwright, expect


def run(playwright: Playwright) -> None:
    browser = playwright.chromium.launch(headless=False)
    context = browser.new_context(ignore_https_errors=True)
    page = context.new_page()
    page.goto("https://test2.saas-test3.supcon.com:32188/login#/login")
    page.get_by_role("textbox", name="请输入用户名").click()
    page.get_by_role("textbox", name="请输入用户名").fill("admin")
    page.get_by_role("textbox", name="请输入密码").click()
    page.get_by_role("textbox", name="请输入密码").fill("python record.py -p LD -m customer_file -c verify_delete_button -u \"https://test2.saas-test3.supcon.com:32188\" -b chromium -f 1")
    page.get_by_role("textbox", name="请输入密码").press("ControlOrMeta+z")
    page.get_by_role("textbox", name="请输入密码").fill("")
    page.get_by_role("textbox", name="请输入密码").click()
    page.get_by_role("textbox", name="请输入密码").fill("Supcon1304@")
    page.get_by_role("button", name="登 录").click()
    page.get_by_role("button", name="确定").click()
    page.get_by_text("基础资料").click()
    page.get_by_text("客户档案").click()
    page.locator("iframe[name=\"supos-tab-framework-2\"]").content_frame.get_by_role("cell", name="KS202604240006").click()
    page.locator("iframe[name=\"supos-tab-framework-2\"]").content_frame.get_by_role("button", name="edit 编辑").click()
    page.locator("iframe[name=\"supos-tab-framework-2\"]").content_frame.get_by_role("button", name="删除").nth(1).click()
    page.locator("iframe[name=\"supos-tab-framework-2\"]").content_frame.get_by_role("button", name="删除").nth(1).click()
    page.locator("iframe[name=\"supos-tab-framework-2\"]").content_frame.get_by_role("button", name="保 存").click()
    page.locator("iframe[name=\"supos-tab-framework-2\"]").content_frame.locator("div").filter(has_text="保存成功！").nth(3).click()
    page.close()

    # ---------------------
    context.close()
    browser.close()


with sync_playwright() as playwright:
