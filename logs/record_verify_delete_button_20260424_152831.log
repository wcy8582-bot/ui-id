import pytest
from playwright.sync_api import Page, expect
from src.base.base_test import BaseTest
from src.common.logger import logger

class TestVerifyDeleteButton(BaseTest):
    """
    用例名：verify_delete_button
    用例ms的id：0
    """

    def test_verify_delete_button(self, page: Page, project_name: str):
        f"""测试客户档案删除按钮验证功能
        用例名：verify_delete_button
        用例ms的id：0
        项目名：{project_name}

        Args:
            page: 页面实例
            project_name: 项目名称
        """
        logger.info("=" * 60)
        logger.info(f"开始执行用例：verify_delete_button")
        logger.info(f"用例ms的id：0")
        logger.info("=" * 60)
        
        # 使用封装好的公用登录方法登录系统
        logger.info("登录系统")
        self.login(page, project_name)
        
        # 导航进入客户档案页面
        logger.info("进入客户档案页面")
        page.get_by_text("基础资料").click()
        page.get_by_text("客户档案").click()
        
        # 获取iframe内容框架
        frame = page.locator("iframe[name=\"supos-tab-framework-2\"]").content_frame
        
        # 选择目标客户，进入编辑状态
        logger.info("打开目标客户编辑页面")
        frame.get_by_role("cell", name="KS202604240006").click()
        frame.get_by_role("button", name="edit 编辑").click()
        
        # 点击删除按钮
        logger.info("点击删除按钮")
        frame.get_by_role("button", name="删除").nth(1).click()
        
        # 保存删除修改
        logger.info("保存修改")
        frame.get_by_role("button", name="保 存").click()
        
        # 确认保存成功提示
        logger.info("确认操作结果")
        frame.locator("div").filter(has_text="保存成功！").nth(3).click()
        
        logger.info("用例verify_delete_button执行完成")
