from playwright.sync_api import Page, expect
from src.base.base_test import BaseTest
from src.common.logger import logger


class TestVerifyAddChildProduct(BaseTest):
    """
    用例名：verify_add_child_product
    用例ms的id：0
    """

    def test_verify_add_child_product(self, page: Page, project_name: str):
        f"""测试添加BOM子产品功能
        用例名：verify_add_child_product
        用例ms的id：0
        项目名：{project_name}

        Args:
            page: 页面实例
            project_name: 项目名称
        """
        logger.info("=" * 60)
        logger.info(f"开始执行用例：verify_add_child_product")
        logger.info(f"用例ms的id：0")
        logger.info("=" * 60)
        
        # 使用公用登录方法登录系统
        logger.info("登录目标系统")
        self.login(page, project_name)
        
        # 进入物料清单菜单
        logger.info("进入物料清单页面")
        page.get_by_text("基础资料").click()
        page.get_by_text("物料清单").click()

        # 获取BOM页面iframe上下文，简化后续定位
        bom_frame = page.frame_locator("iframe[name=\"supos-tab-framework-2\"]")
        
        # 验证目标BOM行存在，点击编辑
        expect(bom_frame.get_by_role("row", name="6 CP2026042000039 自行车 - 自制 辆").locator("a")).to_be_visible()
        logger.info("打开目标BOM的编辑页面")
        bom_frame.get_by_text("编辑").nth(5).click()

        # 第一次添加子产品操作
        expect(bom_frame.get_by_role("button", name="plus-circle 添加子项产品")).to_be_visible()
        logger.info("点击添加子项产品按钮")
        bom_frame.get_by_role("button", name="plus-circle 添加子项产品").click()

        # 选择子产品
        bom_frame.locator(".ant-table-cell.ant-table-selection-column.ant-table-cell-fix-left.ant-table-cell-row-hover > .ant-checkbox-wrapper > .ant-checkbox > .ant-checkbox-input").check()
        bom_frame.locator(".ant-table-cell.ant-table-selection-column.ant-table-cell-fix-left.ant-table-cell-row-hover > .ant-checkbox-wrapper > .ant-checkbox > .ant-checkbox-input").uncheck()
        bom_frame.get_by_role("row", name="CP2026042200009 笔记本116").get_by_label("", exact=True).check()
        bom_frame.get_by_role("button", name="选 择").click()

        # 第二次添加子产品操作
        logger.info("再次点击添加子项产品按钮")
        bom_frame.get_by_role("button", name="plus-circle 添加子项产品").click()
        bom_frame.get_by_role("row", name="CP2026042200009 笔记本116").get_by_label("", exact=True).check()
        bom_frame.get_by_role("row", name="CP2026042200009 笔记本116").get_by_label("", exact=True).uncheck()
        bom_frame.locator("tr:nth-child(3) > .ant-table-cell.ant-table-selection-column").click()
        bom_frame.get_by_role("button", name="选 择").click()

        # 调整子产品信息
        logger.info("调整新增子产品的配置信息")
        bom_frame.get_by_role("button", name="holder 4 CP2026042200009 笔记本").click()
        bom_frame.locator("#rc_select_10").click()
        expect(bom_frame.locator("#rc_select_10")).to_be_visible()
        bom_frame.get_by_role("columnheader", name="单位", exact=True).click()

        logger.info("用例verify_add_child_product执行完成")
