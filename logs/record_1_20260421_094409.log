import pytest
from playwright.sync_api import Page, expect
from src.base.base_test import BaseTest
from src.common.logger import logger

class TestAddProductArchive(BaseTest):
    """
    用例名：1
    用例ms的id：0
    """

    def test_add_product_archive(self, page: Page, project_name: str):
        f"""测试新增产品档案功能
        用例名：1
        用例ms的id：0
        项目名：{project_name}

        Args:
            page: 页面实例
            project_name: 项目名称
        """
        logger.info("=" * 60)
        logger.info(f"开始执行1")
        logger.info(f"用例ms的id：0")
        logger.info("=" * 60)
        
        # 使用公用登录方法
        self.login(page, project_name)
        
        # 搜索进入产品档案模块
        logger.info("搜索并进入产品档案模块")
        page.get_by_role("textbox", name="搜索").click()
        page.get_by_role("textbox", name="搜索").fill("产品档案")
        page.get_by_text("产品档案").click()
        
        # 获取产品档案页面iframe
        product_frame = page.locator("iframe[name=\"supos-tab-framework-2\"]").content_frame
        logger.info("执行新增产品档案相关操作")
        # 点击新增按钮
        product_frame.get_by_role("button", name="plus-circle 新增").click()
        # 关闭新增弹窗
        product_frame.get_by_role("button", name="Close").click()
        # 再次打开新增弹窗
        product_frame.get_by_role("button", name="plus-circle 新增").click()
        # 保留原有操作：触发快捷键搜索
        product_frame.locator(".ant-modal > div").first.press("ControlOrMeta+f")
        # 点击跳转首页产品档案
        page.get_by_text("首页产品档案").click()
        
        logger.info("用例执行完成")
