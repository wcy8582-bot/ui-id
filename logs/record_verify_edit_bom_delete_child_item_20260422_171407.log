import pytest
from playwright.sync_api import Page, expect
from src.base.base_test import BaseTest
from src.common.logger import logger


class TestEditBOM(BaseTest):
    """
    用例名：verify_edit_bom_delete_child_item
    用例ms的id：0
    """

    def test_verify_edit_bom_delete_child_item(self, page: Page, project_name: str):
        f"""测试编辑BOM删除子项功能
        用例名：verify_edit_bom_delete_child_item
        用例ms的id：0
        项目名：{project_name}

