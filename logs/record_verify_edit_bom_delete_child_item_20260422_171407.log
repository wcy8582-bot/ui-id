        logger.info("=" * 60)
        
        # 使用公用登录方法
        logger.info("执行登录操作")
        self.login(page, project_name)
        
        # 进入物料清单页面
        logger.info("进入基础资料->物料清单模块")
        page.get_by_text("基础资料").click()
        page.get_by_text("物料清单").click()

        # 验证目标BOM，点击编辑
        expect(page.locator("iframe[name=\"supos-tab-framework-2\"]").content_frame.get_by_role("row", name="2 CP2026042000034 半成品2").locator("a")).to_be_visible()
        expect(page.locator("iframe[name=\"supos-tab-framework-2\"]").content_frame.get_by_text("编辑").nth(1)).to_be_visible()
        page.locator("iframe[name=\"supos-tab-framework-2\"]").content_frame.get_by_text("编辑").nth(1).click()

        # 验证编辑页面加载完成
        expect(page.locator("iframe[name=\"supos-tab-framework-2\"]").content_frame.locator("div").filter(has_text=re.compile(r"^子项产品信息$"))).to_be_visible()
        expect(page.locator("iframe[name=\"supos-tab-framework-2\"]").content_frame.get_by_text("添加子项产品序号物料编号物料名称物料规格单位用量关联工序单位物料来源库存数量备注操作 1CP2026042000037物料21半成品2工序1千克外采0删除")).to_be_visible()
        expect(page.locator("iframe[name=\"supos-tab-framework-2\"]").content_frame.get_by_role("button", name="删除").nth(1)).to_be_visible()

        # 删除目标子项
