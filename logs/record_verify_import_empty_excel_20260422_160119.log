from playwright.sync_api import Playwright, sync_playwright, expect


def run(playwright: Playwright) -> None:
    browser = playwright.chromium.launch(headless=False)
    context = browser.new_context(ignore_https_errors=True)
    page = context.new_page()
    page.goto("https://test2.saas-test3.supcon.com:32188/login#/login")
    page.get_by_role("textbox", name="请输入用户名").click()
    page.get_by_role("textbox", name="请输入用户名").fill("admin")
    page.get_by_role("textbox", name="请输入密码").click()
    page.get_by_role("textbox", name="请输入密码").fill("Supcon1304@")
    page.get_by_role("button", name="登 录").click()
    page.get_by_text("基础资料").click()
    page.get_by_text("物料清单").click()
    expect(page.locator("iframe[name=\"supos-tab-framework-2\"]").content_frame.get_by_role("button", name="import 导入")).to_be_visible()
    page.locator("iframe[name=\"supos-tab-framework-2\"]").content_frame.get_by_role("button", name="import 导入").click()
    expect(page.locator("iframe[name=\"supos-tab-framework-2\"]").content_frame.get_by_text("文件选择模板下载")).to_be_visible()
    expect(page.locator("iframe[name=\"supos-tab-framework-2\"]").content_frame.get_by_role("button").filter(has_text=re.compile(r"^$")).nth(3)).to_be_visible()
    page.locator("iframe[name=\"supos-tab-framework-2\"]").content_frame.get_by_role("button").filter(has_text=re.compile(r"^$")).nth(3).click()
    page.locator("iframe[name=\"supos-tab-framework-2\"]").content_frame.get_by_role("button").filter(has_text=re.compile(r"^$")).nth(3).set_input_files("工作簿1.xlsx")
    expect(page.locator("iframe[name=\"supos-tab-framework-2\"]").content_frame.get_by_text("文件选择模板下载")).to_be_visible()
    page.locator("iframe[name=\"supos-tab-framework-2\"]").content_frame.get_by_role("button", name="确 认").click()
    expect(page.locator("iframe[name=\"supos-tab-framework-2\"]").content_frame.locator("div").filter(has_text="[2026-04-22 16:02:40 912").nth(5)).to_be_visible()
    page.locator("iframe[name=\"supos-tab-framework-2\"]").content_frame.get_by_role("button", name="关 闭").click()
    page.close()

    # ---------------------
    context.close()
    browser.close()


with sync_playwright() as playwright:
    run(playwright)

