import pytest
from playwright.sync_api import Page, expect
from src.base.base_test import BaseTest
from src.common.logger import logger


class TestVerifyCreateCodeRule(BaseTest):
    """
    用例名：verify_create_button
    用例ms的id：0
    """

    def test_verify_create_button(self, page: Page, project_name: str):
        f"""测试新增编码规则功能
        用例名：verify_create_button
        用例ms的id：0
        项目名：{project_name}

        Args:
            page: 页面实例
            project_name: 项目名称
        """
        logger.info("=" * 60)
        logger.info(f"开始执行用例：verify_create_button")
        logger.info(f"用例ms的id：0")
        logger.info("=" * 60)
        
        # 使用封装好的公用登录方法登录
        logger.info("登录系统")
        self.login(page, project_name)

        # 进入编码规则配置菜单
        logger.info("进入编码规则配置页面")
        page.get_by_text("基础资料").click()
        page.get_by_text("编码规则配置").click()

        # 获取功能页面iframe，简化重复定位
        rule_frame = page.locator("iframe[name=\"supos-tab-framework-2\"]").content_frame

        # 打开新增编码规则弹窗
        logger.info("点击创建按钮打开新增弹窗")
        rule_frame.get_by_role("button", name="plus-circle 创建").click()

        # 填写规则编码
        logger.info("填写规则编码")
        code_input = rule_frame.get_by_role("textbox", name="请输入规则编码，忽略将自动生成")
        code_input.click()
        code_input.press("CapsLock")
        code_input.fill("AA00006")

        # 填写规则名称
        logger.info("填写规则名称")
        rule_frame.get_by_role("textbox", name="请输入规则名称").fill("Q")

        # 选择业务类型
        logger.info("选择业务类型：采购入库批号")
        rule_frame.get_by_role("dialog", name="新增编码规则").locator("#businessTypeId").click()
        rule_frame.get_by_text("采购入库批号").nth(1).click()

        # 增行配置编码规则
        logger.info("添加配置编码分段规则")
        rule_frame.get_by_role("button", name="plus-circle 增行").click()
        rule_frame.locator("#rc_select_4").click()
        rule_frame.get_by_text("日期时间").click()
        rule_frame.locator("#rc_select_6").click()
        rule_frame.get_by_text("yy").nth(3).click()

        # 保存新增规则
        logger.info("保存新增编码规则")
        rule_frame.get_by_role("button", name="保 存").click()

        # 验证创建结果可操作
        logger.info("验证创建完成后的操作入口")
        rule_frame.get_by_text("停用").nth(4).click()

        logger.info(f"用例verify_create_button执行完成")
