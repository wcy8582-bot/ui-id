        create_dialog = tab_frame.get_by_role("dialog", name="创建仓库")
        
        # 填写仓库基础信息
        logger.info("填写仓库编码和名称信息")
        create_dialog.locator("#code").click()
        create_dialog.locator("#code").fill("11")
