from playwright.sync_api import Playwright, sync_playwright, expect


def run(playwright: Playwright) -> None:
    browser = playwright.chromium.launch(headless=False)
    context = browser.new_context(ignore_https_errors=True)
    page = context.new_page()
    page.goto("https://test2.saas-test3.supcon.com:32188/login#/login")
    page.get_by_role("textbox", name="请输入用户名").click()
    page.get_by_role("textbox", name="请输入用户名").fill("admin")
    page.get_by_role("textbox", name="请输入密码").click()
    page.get_by_role("textbox", name="请输入密码").fill("Supcon1304@")
    page.get_by_role("button", name="登 录").click()
    page.get_by_role("button", name="确定").click()
    page.get_by_text("基础资料").click()
    page.get_by_text("基础信息").click()
    page.get_by_text("仓库管理").first.click()
    page.locator("iframe[name=\"supos-tab-framework-2\"]").content_frame.get_by_role("button", name="plus-circle 创建").click()
    page.locator("iframe[name=\"supos-tab-framework-2\"]").content_frame.get_by_role("dialog", name="创建仓库").locator("#code").click()
    page.locator("iframe[name=\"supos-tab-framework-2\"]").content_frame.get_by_role("dialog", name="创建仓库").locator("#code").fill("11")
    page.locator("iframe[name=\"supos-tab-framework-2\"]").content_frame.get_by_role("dialog", name="创建仓库").locator("#name").click()
    page.locator("iframe[name=\"supos-tab-framework-2\"]").content_frame.get_by_role("dialog", name="创建仓库").locator("#name").fill("创建按钮")
    page.locator("iframe[name=\"supos-tab-framework-2\"]").content_frame.get_by_title("仓库", exact=True).click()
    page.locator("iframe[name=\"supos-tab-framework-2\"]").content_frame.get_by_label("创建仓库").get_by_text("仓库", exact=True).click()
    page.locator("iframe[name=\"supos-tab-framework-2\"]").content_frame.get_by_role("button", name="保 存").click()
    page.close()

    # ---------------------
    context.close()
    browser.close()


with sync_playwright() as playwright:
    run(playwright)

