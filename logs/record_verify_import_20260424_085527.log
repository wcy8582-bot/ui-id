from playwright.sync_api import Playwright, sync_playwright, expect


def run(playwright: Playwright) -> None:
    browser = playwright.chromium.launch(headless=False)
    context = browser.new_context(ignore_https_errors=True)
    page = context.new_page()
    page.goto("https://test2.saas-test3.supcon.com:32188/login#/login")
    page.get_by_role("textbox", name="请输入用户名").click()
    page.get_by_role("textbox", name="请输入用户名").fill("admin")
    page.get_by_role("textbox", name="请输入密码").click()
    page.get_by_role("textbox", name="请输入密码").click()
    page.get_by_role("textbox", name="请输入密码").fill("Supcon1304@")
    page.get_by_role("button", name="登 录").click()
    page.get_by_text("基础资料").click()
    page.get_by_text("客户档案").click()
    page.locator("iframe[name=\"supos-tab-framework-2\"]").content_frame.get_by_role("button", name="import 导入").first.click()
    page.locator("iframe[name=\"supos-tab-framework-2\"]").content_frame.get_by_role("button").filter(has_text=re.compile(r"^$")).nth(5).click()
    page.locator("iframe[name=\"supos-tab-framework-2\"]").content_frame.get_by_role("button").filter(has_text=re.compile(r"^$")).nth(5).set_input_files("客户资料_2026_04_24.xls")
    page.locator("iframe[name=\"supos-tab-framework-2\"]").content_frame.get_by_role("button", name="确 认").click()
    page.locator("iframe[name=\"supos-tab-framework-2\"]").content_frame.get_by_text("[2026-04-24 08:56:19 104] - 导入开始 [2026-04-24 08:56:19 161] - 校验开始（1/1） [2026-04").click()
    page.locator("iframe[name=\"supos-tab-framework-2\"]").content_frame.get_by_role("button", name="关 闭").click()
    page.close()

    # ---------------------
    context.close()
    browser.close()


with sync_playwright() as playwright:
    run(playwright)

