import pytest
from playwright.sync_api import Page, expect
from src.base.base_test import BaseTest
from src.common.logger import logger

class TestVerifyImport(BaseTest):
    """
    用例名：verify_import
    用例ms的id：0
    """

    def test_verify_import(self, page: Page, project_name: str):
        f"""测试客户档案导入功能
        用例名：verify_import
        用例ms的id：0
        项目名：{project_name}

        Args:
            page: 页面实例
            project_name: 项目名称
        """
        logger.info("=" * 60)
        logger.info(f"开始执行verify_import")
        logger.info(f"用例ms的id：0")
        logger.info("=" * 60)
        
        # 使用公用登录方法
        self.login(page, project_name)
        
        # 进入客户档案模块
        logger.info("进入客户档案页面")
        page.get_by_text("基础资料").click()
        page.get_by_text("客户档案").click()
        
        # 获取内容iframe，准备导入操作
        content_iframe = page.locator("iframe[name=\"supos-tab-framework-2\"]").content_frame
        
        # 触发导入，上传文件
        logger.info("上传待导入的客户资料文件")
        content_iframe.get_by_role("button", name="import 导入").first.click()
        file_btn = content_iframe.get_by_role("button").filter(has_text=re.compile(r"^$")).nth(5)
        file_btn.click()
        file_btn.set_input_files("客户资料_2026_04_24.xls")
        
        # 确认导入
        logger.info("确认执行导入")
        content_iframe.get_by_role("button", name="确 认").click()
        
        # 关闭导入结果弹窗
        logger.info("关闭导入结果弹窗")
        content_iframe.get_by_text("[2026-04-24 08:56:19 104] - 导入开始 [2026-04-24 08:56:19 161] - 校验开始（1/1） [2026-04").click()
        content_iframe.get_by_role("button", name="关 闭").click()
        
        logger.info("verify_import用例执行完成")
