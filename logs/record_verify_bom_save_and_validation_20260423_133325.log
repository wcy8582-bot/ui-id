    page.locator("iframe[name=\"supos-tab-framework-2\"]").content_frame.locator("label").filter(has_text=re.compile(r"^父项产品$")).click()
    page.locator("iframe[name=\"supos-tab-framework-2\"]").content_frame.locator("div").filter(has_text=re.compile(r"^请选择产品$")).nth(4).click()
    page.locator("iframe[name=\"supos-tab-framework-2\"]").content_frame.get_by_role("button", name="保 存").click()
    page.locator("iframe[name=\"supos-tab-framework-2\"]").content_frame.locator("#combineValue_help").get_by_text("请选择产品").click()
    expect(page.locator("iframe[name=\"supos-tab-framework-2\"]").content_frame.locator("div").filter(has_text=re.compile(r"^父项产品请选择产品请选择产品$")).first).to_be_visible()
    page.locator("iframe[name=\"supos-tab-framework-2\"]").content_frame.locator("#rc_select_3").click()
    page.locator("iframe[name=\"supos-tab-framework-2\"]").content_frame.locator("#rc_select_3").press("CapsLock")
    page.locator("iframe[name=\"supos-tab-framework-2\"]").content_frame.locator("#rc_select_3").fill("FJ")
    page.locator("iframe[name=\"supos-tab-framework-2\"]").content_frame.locator("#rc_select_3").press("CapsLock")
    page.locator("iframe[name=\"supos-tab-framework-2\"]").content_frame.locator("#rc_select_3").fill("FJ00001")
    page.locator("iframe[name=\"supos-tab-framework-2\"]").content_frame.get_by_text("FJ00001 | 博士伦-不锈钢-金属镜架-枪色").click()
    expect(page.locator("iframe[name=\"supos-tab-framework-2\"]").content_frame.get_by_text("添加子项产品序号物料编号物料名称物料规格单位用量关联工序单位物料来源库存数量备注操作 1PJ00184镜腿套-海伦凯勒中号工序C副委外0删除 To pick")).to_be_visible()
    page.close()

    # ---------------------
    context.close()
    browser.close()


with sync_playwright() as playwright:
    run(playwright)

