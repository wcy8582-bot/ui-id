from playwright.sync_api import Page, expect
from src.base.base_test import BaseTest
from src.common.logger import logger


class TestVerifyBomSaveAndValidation(BaseTest):
    """
    用例名：verify_bom_save_and_validation
    用例ms的id：0
    """

    def test_verify_bom_save_and_validation(self, page: Page, project_name: str):
        f"""测试BOM保存校验功能
        用例名：verify_bom_save_and_validation
        用例ms的id：0
        项目名：{project_name}

        Args:
            page: 页面实例
            project_name: 项目名称
        """
        logger.info("=" * 60)
        logger.info(f"开始执行用例：verify_bom_save_and_validation")
        logger.info(f"用例ms ID：0")
        logger.info("=" * 60)
        
        # 调用封装好的公用登录方法
        logger.info("登录目标系统")
        self.login(page, project_name)

        # 进入物料清单模块
        logger.info("导航进入物料清单页面")
        page.get_by_text("基础资料").click()
        page.get_by_text("物料清单").click()

        # 获取页面iframe内容帧
        bom_frame = page.locator("iframe[name=\"supos-tab-framework-2\"]").content_frame

        # 点击新增BOM
        logger.info("点击新增BOM按钮")
        bom_frame.get_by_role("button", name="plus-circle 新增").click()

        # 触发空父项保存校验
        logger.info("触发空父项产品保存校验")
        bom_frame.locator("label").filter(has_text=re.compile(r"^父项产品$")).click()
        bom_frame.locator("div").filter(has_text=re.compile(r"^请选择产品$")).nth(4).click()
        bom_frame.get_by_role("button", name="保 存").click()
        bom_frame.locator("#combineValue_help").get_by_text("请选择产品").click()
        expect(bom_frame.locator("div").filter(has_text=re.compile(r"^父项产品请选择产品请选择产品$")).first).to_be_visible()

        # 选择父项产品
        logger.info("输入并选择目标父项产品")
        bom_frame.locator("#rc_select_3").click()
        # 去除录制产生的多余重复按键操作，直接输入目标产品编号
        bom_frame.locator("#rc_select_3").fill("FJ00001")
        bom_frame.get_by_text("FJ00001 | 博士伦-不锈钢-金属镜架-枪色").click()

        # 断言结果
        logger.info("断言子项产品加载成功")
        expect(bom_frame.get_by_text("添加子项产品序号物料编号物料名称物料规格单位用量关联工序单位物料来源库存数量备注操作 1PJ00184镜腿套-海伦凯勒中号工序C副委外0删除 To pick")).to_be_visible()

        logger.info("用例verify_bom_save_and_validation执行完成")
