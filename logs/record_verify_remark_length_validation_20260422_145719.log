from playwright.sync_api import Page, expect
from src.base.base_test import BaseTest
from src.common.logger import logger


class TestVerifyRemarkLengthValidation(BaseTest):
    """
    用例名：verify_remark_length_validation
    用例ms的id：0
    """

    def test_verify_remark_length_validation(self, page: Page, project_name: str):
        f"""测试物料清单超长备注保存功能
        用例名：verify_remark_length_validation
        用例ms的id：0
        项目名：{project_name}

        Args:
            page: 页面实例
            project_name: 项目名称
        """
        logger.info("=" * 60)
        logger.info(f"开始执行用例：verify_remark_length_validation")
        logger.info(f"用例ms ID：0")
        logger.info("=" * 60)
        
        # 使用封装好的公用登录方法登录系统
        logger.info("执行系统登录")
        self.login(page, project_name)
        
        # 导航到物料清单页面
        logger.info("导航到物料清单模块")
        page.get_by_text("基础资料").click()
        page.get_by_text("物料清单").click()
        
        # 提取iframe上下文，简化后续定位
        tab_frame = page.locator("iframe[name=\"supos-tab-framework-2\"]").content_frame
        logger.info("定位物料清单列表iframe成功")
        
        # 验证目标BOM存在并打开编辑
        expect(tab_frame.get_by_role("cell", name="FJ00001")).to_be_visible()
        logger.info("目标BOM FJ00001加载完成")
        tab_frame.get_by_role("cell", name="FJ00001").click()
        tab_frame.get_by_text("编辑").first.click()
        logger.info("打开目标BOM编辑页面")
        
        # 验证备注输入框就绪
        expect(tab_frame.get_by_label("创建物料清单").get_by_role("columnheader", name="备注")).to_be_visible()
        expect(tab_frame.locator("input[type=\"textarea\"]")).to_be_visible()
        
        # 输入超长备注文本
        long_remark = "备注备注备注备注备注备注备注备注备注备注备注备注备注备注备注备注备注备注备注备注备注备注备注备注备注备注备注备注备注备注备注备注备注备注备注备注备注备注备注备注备注备注备注备注备注备注备注备注备注备注备注备注备注备注备注备注备注备注备注备注备注备注备注备注备注备注备注备注备注备注备注备注备注备注备注备注备注备注备注备注备注备注备注备注备注备注备注备注备注备注备注备注备注备注备注"
        tab_frame.locator("input[type=\"textarea\"]").click()
        tab_frame.locator("input[type=\"textarea\"]").fill(long_remark)
        logger.info("已完成超长备注内容输入")
        
        # 提交保存修改
        tab_frame.get_by_role("button", name="保 存").click()
        tab_frame.get_by_role("button", name="确 认").click()
        logger.info("提交修改保存请求")
        
        # 验证保存结果
        expect(tab_frame.locator("div").filter(has_text="保存成功！").nth(3)).to_be_visible()
        logger.info("验证通过：超长备注保存成功，用例执行完成")
