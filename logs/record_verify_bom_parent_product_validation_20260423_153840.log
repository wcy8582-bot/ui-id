    page.locator("iframe[name=\"supos-tab-framework-2\"]").content_frame.get_by_title("博士伦-不锈钢-金属镜架-枪色").nth(1).click()
    page.locator("iframe[name=\"supos-tab-framework-2\"]").content_frame.get_by_text("添加子项产品序号物料编号物料名称物料规格单位用量关联工序单位物料来源库存数量备注操作 1PJ00184镜腿套-海伦凯勒中号工序C副委外0删除 To pick").click()
    page.close()

    # ---------------------
    context.close()
    browser.close()


with sync_playwright() as playwright:
