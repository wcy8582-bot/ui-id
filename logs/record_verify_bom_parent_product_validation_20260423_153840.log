    page.locator("iframe[name=\"supos-tab-framework-2\"]").content_frame.get_by_text("父项产品", exact=True).click()
    page.locator("iframe[name=\"supos-tab-framework-2\"]").content_frame.locator("#rc_select_3").click()
    page.locator("iframe[name=\"supos-tab-framework-2\"]").content_frame.locator("div").filter(has_text=re.compile(r"^暂无数据$")).nth(4).click()
    page.locator("iframe[name=\"supos-tab-framework-2\"]").content_frame.get_by_role("button", name="保 存").click()
    page.locator("iframe[name=\"supos-tab-framework-2\"]").content_frame.get_by_text("父项产品请选择产品请选择产品").click()
    page.locator("iframe[name=\"supos-tab-framework-2\"]").content_frame.locator("#rc_select_3").click()
    page.locator("iframe[name=\"supos-tab-framework-2\"]").content_frame.locator("#rc_select_3").press("CapsLock")
