        logger.info(f"开始执行用例：verify_child_product")
        logger.info(f"用例ms ID：0")
        logger.info("=" * 60)
        
        # 使用封装好的公用登录方法
        logger.info("完成系统登录")
        self.login(page, project_name)

        # 导航进入物料清单页面
        logger.info("进入物料清单菜单")
        page.get_by_text("基础资料").click()
        page.get_by_text("物料清单").click()

        # 获取iframe内容框架，优化重复定位
        bom_frame = page.locator("iframe[name=\"supos-tab-framework-2\"]").content_frame

        # 验证页面关键元素可见
        logger.info("验证页面初始元素状态")
        expect(bom_frame.get_by_role("cell", name="CPTB001")).to_be_visible()
        expect(bom_frame.get_by_text("编辑").first).to_be_visible()

        # 进入编辑状态
        logger.info("点击编辑按钮")
        bom_frame.get_by_text("编辑").first.click()

        # 点击添加子项产品按钮
        logger.info("触发添加子项产品操作")
        bom_frame.get_by_role("button", name="plus-circle 添加子项产品").click()

        # 执行业务操作，去除录制产生的重复点击
        logger.info("执行页面操作")
        bom_frame.locator("#table_2 > .ant-table-container").click()
        bom_frame.get_by_label("产品参照").get_by_role("button", name="取 消").click()
        bom_frame.get_by_role("button", name="删除", exact=True).click()
        bom_frame.get_by_role("button", name="暂无数据").click()
