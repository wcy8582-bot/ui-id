import pytest
from playwright.sync_api import Page, expect
from src.base.base_test import BaseTest
from src.common.logger import logger

class TestLogin(BaseTest):
    """
    用例名：login
    用例ms的id：0
    """

    def test_login(self, page: Page, project_name: str):
        f"""测试百度页面跳转流程
        用例名：login
        用例ms的id：0
        项目名：{project_name}
        
        Args:
            page: 页面实例
            project_name: 项目名称
        """
        logger.info("=" * 60)
        logger.info(f"开始执行用例：login")
        logger.info(f"用例ms的id：0")
        logger.info("=" * 60)
        
        # 调用封装好的公用登录方法
        logger.info("完成系统登录")
        self.login(page, project_name)
        
        # 导航到百度首页
        logger.info("导航到百度首页")
        page.goto("https://www.baidu.com/")
        
        # 点击链接打开新页面
        logger.info("点击「 建设网络强国」链接，打开新页面")
        with page.expect_popup() as page1_info:
            page.get_by_role("link", name=" 建设网络强国").click()
        page1 = page1_info.value
        
        # 点击杭州榜
        logger.info("点击「杭州榜」选项")
        page1.get_by_text("杭州榜").click()
        
        # 点击新闻链接打开新页面
        logger.info("点击「杭州今天多云 降雨已蓄势待发」链接，打开新闻详情页")
        with page1.expect_popup() as page2_info:
            page1.get_by_role("link", name="杭州今天多云 降雨已蓄势待发").click()
        page2 = page2_info.value
        
        # 关闭所有打开的页面
        logger.info("关闭所有打开的页面，清理测试环境")
        page2.close()
        page1.close()
        page.close()

        logger.info("用例执行完成")
