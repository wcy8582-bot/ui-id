import pytest
from playwright.sync_api import Page, expect
from src.base.base_test import BaseTest
from src.common.logger import logger

class TestVerifyImport(BaseTest):
    """
    用例名：verify_import
    用例ms的id：0
    """

    def test_verify_import(self, page: Page, project_name: str):
        f"""测试客户档案导入功能
        用例名：verify_import
        用例ms的id：0
        项目名：{project_name}

        Args:
            page: 页面实例
            project_name: 项目名称
        """
        logger.info("=" * 60)
        logger.info(f"开始执行用例：verify_import")
        logger.info(f"用例ms的id：0")
        logger.info("=" * 60)
        
        # 使用公用登录方法完成系统登录
        logger.info("完成系统登录")
        self.login(page, project_name)
        
        # 导航进入客户档案页面
        logger.info("进入客户档案页面")
        page.get_by_text("基础资料").click()
        page.get_by_text("客户档案").click()
        
        # 获取iframe内容帧，打开导入弹窗
        logger.info("打开客户导入弹窗")
        frame = page.locator("iframe[name=\"supos-tab-framework-2\"]").content_frame
        frame.get_by_role("button", name="import 导入").first.click()
        
        # 断言导入弹窗元素可见
        expect(frame.get_by_text("文件选择模板下载操作模式更新并新增导入说明:1.仅支持")).to_be_visible()
        file_upload_btn = frame.get_by_role("button").filter(has_text=re.compile(r"^$")).nth(5)
        expect(file_upload_btn).to_be_visible()
        
        # 上传文件并提交导入
        logger.info("上传导入文件，确认导入")
        file_upload_btn.click()
        file_upload_btn.set_input_files("客户资料_2026_04_24.xls")
        frame.get_by_role("button", name="确 认").click()
        
        # 查看导入结果，关闭弹窗
        logger.info("关闭导入结果弹窗")
        frame.get_by_text("[2026-04-24 10:13:18 261] - 导入开始 [2026-04-24 10:13:18 311] - 校验开始（1/1） [2026-04").click()
        frame.get_by_role("button", name="关 闭").click()
        
        logger.info(f"用例verify_import执行完成")
