from playwright.sync_api import Playwright, sync_playwright, expect


def run(playwright: Playwright) -> None:
    browser = playwright.chromium.launch(headless=False)
    context = browser.new_context(ignore_https_errors=True)
    page = context.new_page()
    page.goto("https://test2.saas-test3.supcon.com:32188/login#/login")
    page.get_by_role("textbox", name="请输入用户名").click()
    page.get_by_role("textbox", name="请输入用户名").fill("uitest")
    page.get_by_role("textbox", name="请输入密码").click()
    page.get_by_role("textbox", name="请输入密码").fill("Supcon@1304")
    page.get_by_role("button", name="登 录").click()
    page.get_by_text("基础资料").click()
    page.get_by_text("物料清单", exact=True).click()
    page.locator("iframe[name=\"supos-tab-framework-2\"]").content_frame.get_by_role("button", name="plus-circle 新增").click()
    expect(page.locator("iframe[name=\"supos-tab-framework-2\"]").content_frame.get_by_label("创建物料清单")).to_contain_text("父项产品信息")
    expect(page.locator("iframe[name=\"supos-tab-framework-2\"]").content_frame.get_by_label("创建物料清单")).to_contain_text("子项产品信息")
    page.locator("iframe[name=\"supos-tab-framework-2\"]").content_frame.locator(".anticon.anticon-search > svg").click()
    page.locator("iframe[name=\"supos-tab-framework-2\"]").content_frame.get_by_role("row", name="CP2026042000050 wt自行车 成品 - - 自制 辆 自行车生产 - yanshou 2026-04-20 17:25:43 yanshou").get_by_label("", exact=True).check()
    page.locator("iframe[name=\"supos-tab-framework-2\"]").content_frame.get_by_role("button", name="选 择").click()
    expect(page.locator("iframe[name=\"supos-tab-framework-2\"]").content_frame.get_by_label("创建物料清单")).to_contain_text("添加子项产品")
    expect(page.locator("iframe[name=\"supos-tab-framework-2\"]").content_frame.get_by_label("创建物料清单").locator("thead")).to_contain_text("序号")
    expect(page.locator("iframe[name=\"supos-tab-framework-2\"]").content_frame.get_by_label("创建物料清单").locator("thead")).to_contain_text("物料编号")
    expect(page.locator("iframe[name=\"supos-tab-framework-2\"]").content_frame.get_by_label("创建物料清单").locator("thead")).to_contain_text("物料名称")
    expect(page.locator("iframe[name=\"supos-tab-framework-2\"]").content_frame.get_by_label("创建物料清单").locator("thead")).to_contain_text("物料规格")
    expect(page.locator("iframe[name=\"supos-tab-framework-2\"]").content_frame.get_by_label("创建物料清单").locator("thead")).to_contain_text("单位用量")
    expect(page.locator("iframe[name=\"supos-tab-framework-2\"]").content_frame.get_by_label("创建物料清单").locator("thead")).to_contain_text("关联工序")

    # ---------------------
    context.close()
    browser.close()


with sync_playwright() as playwright:
    run(playwright)

