import pytest
from playwright.sync_api import Page, expect
from src.base.base_test import BaseTest
from src.common.logger import logger

class TestCreateBOM(BaseTest):
    """
    用例名：1
    用例ms的id：0
    """

    def test_create_bom(self, page: Page, project_name: str):
        f"""测试新增物料清单功能
        用例名：1
        用例ms的id：0
        项目名：{project_name}

        Args:
            page: 页面实例
            project_name: 项目名称
        """
        logger.info("=" * 60)
        logger.info(f"开始执行{1}")
        logger.info(f"用例ms的id：{0}")
        logger.info("=" * 60)
        
        # 使用公用登录方法完成登录
        logger.info("完成系统登录")
        self.login(page, project_name)
        
        # 进入物料清单功能页面
        logger.info("导航到物料清单页面")
        page.get_by_text("基础资料").click()
        page.get_by_text("物料清单", exact=True).click()
        
        # 获取目标iframe内容页，简化重复定位
        bom_frame = page.locator("iframe[name=\"supos-tab-framework-2\"]").content_frame
        
        # 点击新增按钮打开创建弹窗
        logger.info("点击新增按钮，打开创建物料清单弹窗")
        bom_frame.get_by_role("button", name="plus-circle 新增").click()
        
        # 验证创建弹窗基础元素显示
        logger.info("验证创建弹窗基础区域显示正确")
        expect(bom_frame.get_by_label("创建物料清单")).to_contain_text("父项产品信息")
        expect(bom_frame.get_by_label("创建物料清单")).to_contain_text("子项产品信息")
        
        # 选择父项产品
        logger.info("打开产品选择弹窗并选中目标父项产品")
        bom_frame.locator(".anticon.anticon-search > svg").click()
        bom_frame.get_by_role("row", name="CP2026042000050 wt自行车 成品 - - 自制 辆 自行车生产 - yanshou 2026-04-20 17:25:43 yanshou").get_by_label("", exact=True).check()
        bom_frame.get_by_role("button", name="选 择").click()
        
        # 验证子项区域表头显示
        logger.info("验证子项产品表格表头显示符合预期")
        expect(bom_frame.get_by_label("创建物料清单")).to_contain_text("添加子项产品")
        expect(bom_frame.get_by_label("创建物料清单").locator("thead")).to_contain_text("序号")
        expect(bom_frame.get_by_label("创建物料清单").locator("thead")).to_contain_text("物料编号")
        expect(bom_frame.get_by_label("创建物料清单").locator("thead")).to_contain_text("物料名称")
        expect(bom_frame.get_by_label("创建物料清单").locator("thead")).to_contain_text("物料规格")
        expect(bom_frame.get_by_label("创建物料清单").locator("thead")).to_contain_text("单位用量")
        expect(bom_frame.get_by_label("创建物料清单").locator("thead")).to_contain_text("关联工序")
        
        logger.info("用例执行完成")
