    page.locator("iframe[name=\"supos-tab-framework-2\"]").content_frame.get_by_role("button", name="import 导入").click()
    expect(page.locator("iframe[name=\"supos-tab-framework-2\"]").content_frame.get_by_text("文件选择模板下载")).to_be_visible()
    page.locator("iframe[name=\"supos-tab-framework-2\"]").content_frame.get_by_role("button").filter(has_text=re.compile(r"^$")).nth(3).click()
