    page.locator("iframe[name=\"supos-tab-framework-2\"]").content_frame.get_by_role("textbox", name="父项产品编码 :").press("CapsLock")
    page.locator("iframe[name=\"supos-tab-framework-2\"]").content_frame.get_by_role("textbox", name="父项产品编码 :").fill("FJ")
    page.locator("iframe[name=\"supos-tab-framework-2\"]").content_frame.get_by_role("textbox", name="父项产品编码 :").press("CapsLock")
    page.locator("iframe[name=\"supos-tab-framework-2\"]").content_frame.get_by_role("textbox", name="父项产品编码 :").fill("FJ00001")
    page.locator("iframe[name=\"supos-tab-framework-2\"]").content_frame.get_by_role("button", name="查 询").click()
    page.locator("iframe[name=\"supos-tab-framework-2\"]").content_frame.locator("div").filter(has_text="新增导入导出序号父项产品编码父项产品名称父项产品规格父项产品来源父项单位子项产品编码子项产品名称子项产品规格子项产品来源备注子项单位创建人单位用量创建时间更新人").nth(4).click()
