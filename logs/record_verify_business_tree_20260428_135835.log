        logger.info(f"用例ms的id：0")
        logger.info("=" * 60)
        
        # 使用公用登录方法登录系统
        self.login(page, project_name)
        logger.info("登录成功，开始导航菜单")

        # 点击打开基础资料菜单
        logger.info("点击基础资料菜单")
        page.get_by_text("基础资料").click()

        # 点击系统配置子菜单
        logger.info("点击系统配置菜单")
        page.locator("div").filter(has_text=re.compile(r"^系统配置$")).nth(2).click()

        # 点击打印机管理菜单
        logger.info("点击打印机管理菜单")
        page.get_by_text("打印机管理").click()

        # 点击进入接口方案配置页面
        logger.info("点击进入接口方案配置页面")
        page.get_by_text("接口方案配置").click()

