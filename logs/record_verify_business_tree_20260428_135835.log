from playwright.sync_api import Playwright, sync_playwright, expect


def run(playwright: Playwright) -> None:
    browser = playwright.chromium.launch(headless=False)
    context = browser.new_context(ignore_https_errors=True)
    page = context.new_page()
    page.goto("https://test2.saas-test3.supcon.com:32188/login#/login")
    page.get_by_role("textbox", name="请输入用户名").click()
    page.get_by_role("textbox", name="请输入用户名").fill("admin")
    page.get_by_role("textbox", name="请输入密码").click()
    page.get_by_role("textbox", name="请输入密码").fill("Supcon1304@")
    page.get_by_role("button", name="登 录").click()
    page.get_by_role("button", name="确定").click()
    page.get_by_text("基础资料").click()
    page.locator("div").filter(has_text=re.compile(r"^系统配置$")).nth(2).click()
    page.get_by_text("打印机管理").click()
    page.get_by_text("接口方案配置").click()
    page.locator("iframe[name=\"supos-tab-framework-3\"]").content_frame.locator("svg").first.click()
    page.locator("iframe[name=\"supos-tab-framework-3\"]").content_frame.locator("svg").first.click()
    page.locator("iframe[name=\"supos-tab-framework-3\"]").content_frame.locator("svg").nth(5).click()
    page.locator("iframe[name=\"supos-tab-framework-3\"]").content_frame.locator(".ant-tree-switcher.ant-tree-switcher_close > .anticon > svg").first.click()
    page.locator("iframe[name=\"supos-tab-framework-3\"]").content_frame.locator(".ant-tree-switcher.ant-tree-switcher_close").first.click()
    page.locator("iframe[name=\"supos-tab-framework-3\"]").content_frame.locator(".ant-tree-switcher.ant-tree-switcher_close > .anticon > svg").click()
    page.locator("iframe[name=\"supos-tab-framework-3\"]").content_frame.locator("svg").first.click()
    page.locator("iframe[name=\"supos-tab-framework-3\"]").content_frame.get_by_text("公共基础").click()
    page.close()

    # ---------------------
    context.close()
    browser.close()


with sync_playwright() as playwright:
    run(playwright)

