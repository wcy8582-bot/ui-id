        content_frame = page.locator("iframe[name=\"supos-tab-framework-3\"]").content_frame
        logger.info("开始操作业务树节点")
        # 操作业务树节点（去除录制重复的多余点击操作，保留核心操作）
        content_frame.locator("svg").first.click()
        content_frame.locator("svg").nth(5).click()
        content_frame.locator(".ant-tree-switcher.ant-tree-switcher_close > .anticon > svg").first.click()
        content_frame.locator(".ant-tree-switcher.ant-tree-switcher_close").first.click()
