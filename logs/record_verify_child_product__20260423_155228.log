        # 设置单位用量
        logger.info("填写产品用量")
        bom_frame.get_by_role("button", name="holder 2 CPZXC001 自行车").get_by_role("spinbutton").click()
        bom_frame.get_by_label("创建物料清单").get_by_role("columnheader", name="单位用量").click()
        bom_frame.get_by_role("button", name="holder 2 CPZXC001 自行车").get_by_role("spinbutton").click()

        # 保存物料清单
        logger.info("保存新增的物料清单")
        bom_frame.get_by_role("button", name="保 存").click()
        bom_frame.locator("#rc_select_10").click()
        bom_frame.get_by_text("发酵面包").click()
        bom_frame.get_by_role("button", name="保 存").click()

        # 确认保存
        expect(bom_frame.locator("div").filter(has_text="提示是否确认保存该物料清单？取 消确 认").nth(5)).to_be_visible()
