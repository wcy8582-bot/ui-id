        logger.info(f"用例ms的id：0")
        logger.info("=" * 60)
        
        # 使用公用登录方法登录系统
        self.login(page, project_name)
        logger.info("登录成功，开始导航到目标页面")

        # 进入物料清单菜单
        logger.info("导航到物料清单页面")
        page.get_by_text("基础资料").click()
        page.get_by_text("物料清单").click()

        # 提取iframe公共实例，简化后续代码
        bom_frame = page.locator("iframe[name=\"supos-tab-framework-2\"]").content_frame
        logger.info("进入物料清单编辑页面")

        # 点击进入编辑状态
        bom_frame.locator(".ant-menu-overflow-item.ant-menu-item.ant-menu-item-active > .ant-menu-title-content > .edit-btn").click()
        # 打开添加子项产品弹窗
        bom_frame.get_by_role("button", name="plus-circle 添加子项产品").click()
        bom_frame.locator(".tree-layout > .list-layout > .table-wrapper").click()
        expect(bom_frame.locator(".tree-layout")).to_be_visible()

        # 取消重新添加
        logger.info("重新选择子产品")
        bom_frame.get_by_label("产品参照").get_by_role("button", name="取 消").click()
        bom_frame.get_by_role("button", name="plus-circle 添加子项产品").click()

        # 选择目标子产品
        bom_frame.get_by_role("row", name="CPZXC001").get_by_label("", exact=True).check()
