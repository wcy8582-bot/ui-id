import pytest
from playwright.sync_api import Page, expect
from src.base.base_test import BaseTest
from src.common.logger import logger


class TestVerifyChildProduct(BaseTest):
    """
    用例名：verify_child_product_
    用例ms的id：0
    """

    def test_verify_child_product_(self, page: Page, project_name: str):
        f"""测试物料清单新增子产品功能
        用例名：verify_child_product_
        用例ms的id：0
        项目名：{project_name}

        Args:
            page: 页面实例
            project_name: 项目名称
        """
        logger.info("=" * 60)
