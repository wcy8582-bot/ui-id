import pytest
from playwright.sync_api import Page, expect
from src.base.base_test import BaseTest
from src.common.logger import logger

class TestVerifyImport(BaseTest):
    """
    用例名：verify_import
    用例ms的id：0
    """

    def test_verify_import(self, page: Page, project_name: str):
        f"""测试客户档案导入功能
        用例名：verify_import
        用例ms的id：0
        项目名：{project_name}

        Args:
            page: 页面实例
            project_name: 项目名称
        """
        logger.info("=" * 60)
        logger.info(f"开始执行用例：verify_import")
        logger.info(f"用例ms的id：0")
        logger.info("=" * 60)
        
        # 调用公用登录方法完成登录
        self.login(page, project_name)
        logger.info("登录成功，进入客户档案页面")

        # 核心操作步骤：导航到客户档案页面
        page.get_by_text("基础资料").click()
        page.get_by_text("物料清单").click()
        page.get_by_text("客户档案").click()

        # 提取iframe，简化后续代码
        customer_iframe = page.locator("iframe[name=\"supos-tab-framework-3\"]").content_frame
        
        # 触发导入操作
        logger.info("开始导入客户档案文件")
        customer_iframe.get_by_role("button", name="import 导入").first.click()
        # 上传导入文件，移除多余的点击操作
        customer_iframe.get_by_role("button").filter(has_text=re.compile(r"^$")).nth(5).set_input_files("客户资料_2026_04_24.xls")
        customer_iframe.get_by_role("button", name="确 认").click()

        # 断言导入成功
        logger.info("断言导入结果")
        expect(customer_iframe.locator("div").filter(has_text="[2026-04-24 09:18:12 632").nth(5)).to_be_visible()

        # 关闭弹窗
        customer_iframe.get_by_role("button", name="关 闭").click()
        logger.info(f"用例verify_import执行完成")
