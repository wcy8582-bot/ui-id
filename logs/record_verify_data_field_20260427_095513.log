from playwright.sync_api import Playwright, sync_playwright, expect


def run(playwright: Playwright) -> None:
    browser = playwright.chromium.launch(headless=False)
    context = browser.new_context(ignore_https_errors=True)
    page = context.new_page()
    page.goto("https://test2.saas-test3.supcon.com:32188/login#/login")
    page.get_by_role("textbox", name="请输入用户名").click()
    page.get_by_role("textbox", name="请输入用户名").fill("admin")
    page.get_by_role("textbox", name="请输入密码").click()
    page.get_by_role("textbox", name="请输入密码").fill("Supcon1304@")
    page.locator("div").filter(has_text=re.compile(r"^登 录$")).nth(2).click()
    page.get_by_role("button", name="确定").click()
    page.get_by_text("基础资料").click()
    page.get_by_text("编码规则配置").click()
    page.locator("iframe[name=\"supos-tab-framework-2\"]").content_frame.get_by_role("button", name="plus-circle 创建").click()
    page.locator("iframe[name=\"supos-tab-framework-2\"]").content_frame.get_by_role("button", name="plus-circle 增行").click()
    page.locator("iframe[name=\"supos-tab-framework-2\"]").content_frame.locator("#rc_select_4").click()
    page.locator("iframe[name=\"supos-tab-framework-2\"]").content_frame.get_by_text("日期时间").click()
    page.locator("iframe[name=\"supos-tab-framework-2\"]").content_frame.locator("#rc_select_6").click()
    page.locator("iframe[name=\"supos-tab-framework-2\"]").content_frame.get_by_text("yy").nth(2).click()
    page.locator("iframe[name=\"supos-tab-framework-2\"]").content_frame.get_by_role("button", name="取 消").click()
    page.close()

    # ---------------------
    context.close()
    browser.close()


with sync_playwright() as playwright:
    run(playwright)

