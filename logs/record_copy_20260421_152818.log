from playwright.sync_api import Playwright, sync_playwright, expect


def run(playwright: Playwright) -> None:
    browser = playwright.chromium.launch(headless=False)
    context = browser.new_context(ignore_https_errors=True)
    page = context.new_page()
    page.goto("https://test2.saas-test3.supcon.com:32188/login#/login")
    page.get_by_role("textbox", name="请输入用户名").click()
    page.get_by_role("textbox", name="请输入用户名").fill("admin")
    page.get_by_role("textbox", name="请输入密码").click()
    page.get_by_role("textbox", name="请输入密码").fill("Supcon1304@")
    page.get_by_role("button", name="登 录").click()
    page.get_by_text("基础资料").click()
    page.get_by_text("产品档案").click()
    page.locator("iframe[name=\"supos-tab-framework-2\"]").content_frame.get_by_role("columnheader", name="操作").click()
    expect(page.locator("iframe[name=\"supos-tab-framework-2\"]").content_frame.get_by_role("cell").filter(has_text="编辑复制删除").first).to_be_visible()
    expect(page.locator("iframe[name=\"supos-tab-framework-2\"]").content_frame.get_by_text("复制").first).to_be_visible()
    page.locator("iframe[name=\"supos-tab-framework-2\"]").content_frame.get_by_text("复制").first.click()
    expect(page.locator("iframe[name=\"supos-tab-framework-2\"]").content_frame.locator("div").filter(has_text="基础信息产品编码产品名称产品规格产品型号单位千克产品属性半成品产品类型产品来源自制标准工时小时分秒产品有效期保质期天最高库存最低库存预警期天工艺路线备注产品图片").nth(5)).to_be_visible()
    page.locator("iframe[name=\"supos-tab-framework-2\"]").content_frame.get_by_role("button", name="保 存").click()
    expect(page.locator("iframe[name=\"supos-tab-framework-2\"]").content_frame.locator("div").filter(has_text="新增批量创建导入导出序号产品编码产品名称产品规格产品图片产品型号单位产品属性产品来源标准工时启用批次管理启用SN").nth(4)).to_be_visible()
    page.close()

    # ---------------------
    context.close()
    browser.close()


with sync_playwright() as playwright:
    run(playwright)

