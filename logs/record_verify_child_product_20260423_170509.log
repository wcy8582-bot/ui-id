import pytest
from playwright.sync_api import Page, expect
from src.base.base_test import BaseTest
from src.common.logger import logger

class TestVerifyChildProduct(BaseTest):
    """
    用例名：verify_child_product
    用例ms的id：0
    """

    def test_verify_child_product(self, page: Page, project_name: str):
        f"""测试物料清单添加子产品功能
        用例名：verify_child_product
        用例ms的id：0
        项目名：{project_name}

        Args:
            page: 页面实例
            project_name: 项目名称
        """
        logger.info("=" * 60)
        logger.info(f"开始执行用例：verify_child_product")
        logger.info(f"用例ms ID：0")
        logger.info("=" * 60)
        
        # 使用公用登录方法登录系统
        logger.info("调用公用登录方法完成登录")
        self.login(page, project_name)

        # 进入物料清单功能页面
        logger.info("导航进入物料清单页面")
        page.get_by_text("基础资料").click()
        page.get_by_text("物料清单").click()

        # 提取iframe内容框架，减少重复代码
        bom_content_frame = page.locator("iframe[name=\"supos-tab-framework-2\"]").content_frame
        
        # 验证目标物料存在
        logger.info("验证物料CPTB001可见")
        expect(bom_content_frame.get_by_role("cell", name="CPTB001")).to_be_visible()

        # 进入编辑模式
        logger.info("点击编辑按钮")
        bom_content_frame.locator(".ant-menu-overflow-item.ant-menu-item.ant-menu-item-active > .ant-menu-title-content > .edit-btn").click()
        
        # 触发添加子项产品
        logger.info("点击添加子项产品按钮")
        bom_content_frame.get_by_role("button", name="plus-circle 添加子项产品").click()
        
        # 选择目标产品
        logger.info("选择产品后确认选择")
        bom_content_frame.locator(".tree-layout > .list-layout > .table-wrapper").click()
        bom_content_frame.locator(".ant-table-cell > .ant-checkbox-wrapper").first.click()
        bom_content_frame.get_by_role("button", name="选 择").click()

        # 选择对应工序
        logger.info("选择饺子工序")
        bom_content_frame.locator("#rc_select_8").click()
        bom_content_frame.get_by_text("饺子工序").click()

        # 保存修改并确认
        logger.info("保存物料清单修改，确认操作")
        bom_content_frame.get_by_role("button", name="保 存").click()
        bom_content_frame.locator("div").filter(has_text="提示是否确认保存该物料清单？取 消确 认").nth(5).click()
        bom_content_frame.get_by_role("button", name="确 认").click()

        # 删除新增子项还原数据
        logger.info("删除新增子项，确认操作")
        bom_content_frame.get_by_text("删除").nth(1).click()
        bom_content_frame.get_by_role("button", name="确 定").click()

        # 验证操作成功
        logger.info("验证操作成功提示，用例执行完成")
        bom_content_frame.locator("div").filter(has_text="操作成功！").nth(3).click()
        logger.info("verify_child_product用例执行完毕")
