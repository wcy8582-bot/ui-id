from playwright.sync_api import Playwright, sync_playwright, expect


def run(playwright: Playwright) -> None:
    browser = playwright.chromium.launch(headless=False)
    context = browser.new_context(ignore_https_errors=True)
    page = context.new_page()
    page.goto("https://test2.saas-test3.supcon.com:32188/login#/login")
    page.get_by_role("textbox", name="请输入用户名").click()
    page.get_by_role("textbox", name="请输入用户名").fill("admin")
    page.get_by_role("textbox", name="请输入密码").click()
    page.get_by_role("textbox", name="请输入密码").fill("Supcon1304@")
    page.get_by_role("button", name="登 录").click()
    page.get_by_role("button", name="确定").click()
    page.get_by_text("基础资料").click()
    page.get_by_text("物料清单").click()
    expect(page.locator("iframe[name=\"supos-tab-framework-2\"]").content_frame.get_by_role("cell", name="CPTB001")).to_be_visible()
    page.locator("iframe[name=\"supos-tab-framework-2\"]").content_frame.locator(".ant-menu-overflow-item.ant-menu-item.ant-menu-item-active > .ant-menu-title-content > .edit-btn").click()
    page.locator("iframe[name=\"supos-tab-framework-2\"]").content_frame.get_by_role("button", name="plus-circle 添加子项产品").click()
    page.locator("iframe[name=\"supos-tab-framework-2\"]").content_frame.locator(".tree-layout > .list-layout > .table-wrapper").click()
    page.locator("iframe[name=\"supos-tab-framework-2\"]").content_frame.locator(".ant-table-cell > .ant-checkbox-wrapper").first.click()
    page.locator("iframe[name=\"supos-tab-framework-2\"]").content_frame.get_by_role("button", name="选 择").click()
    page.locator("iframe[name=\"supos-tab-framework-2\"]").content_frame.locator("#rc_select_8").click()
    page.locator("iframe[name=\"supos-tab-framework-2\"]").content_frame.get_by_text("饺子工序").click()
    page.locator("iframe[name=\"supos-tab-framework-2\"]").content_frame.get_by_role("button", name="保 存").click()
    page.locator("iframe[name=\"supos-tab-framework-2\"]").content_frame.locator("div").filter(has_text="提示是否确认保存该物料清单？取 消确 认").nth(5).click()
    page.locator("iframe[name=\"supos-tab-framework-2\"]").content_frame.get_by_role("button", name="确 认").click()
    page.locator("iframe[name=\"supos-tab-framework-2\"]").content_frame.get_by_text("删除").nth(1).click()
    page.locator("iframe[name=\"supos-tab-framework-2\"]").content_frame.get_by_role("button", name="确 定").click()
    page.locator("iframe[name=\"supos-tab-framework-2\"]").content_frame.locator("div").filter(has_text="操作成功！").nth(3).click()
    page.close()

    # ---------------------
    context.close()
    browser.close()


with sync_playwright() as playwright:
    run(playwright)

