import pytest
from playwright.sync_api import Page, expect
from src.base.base_test import BaseTest
from src.common.logger import logger

class TestMaterialListAddButton(BaseTest):
    """
    用例名：material_list_add_button
    用例ms的id：0
    """

    def test_material_list_add_button(self, page: Page, project_name: str):
        f"""测试物料清单页面操作按钮可见性
        用例名：material_list_add_button
        用例ms的id：0
        项目名：{project_name}

        Args:
            page: 页面实例
            project_name: 项目名称
        """
        logger.info("=" * 60)
        logger.info(f"开始执行用例：material_list_add_button")
        logger.info(f"用例ms的id：0")
        logger.info("=" * 60)
        
        # 使用封装好的公用登录方法
        logger.info("执行系统登录")
        self.login(page, project_name)
        logger.info("登录成功")
        
        # 导航进入物料清单页面
        logger.info("导航到物料清单页面")
        page.get_by_text("基础资料").click()
        page.get_by_text("产品档案").click()
        page.get_by_text("物料清单").click()
        
        # 校验页面核心操作按钮可见
        logger.info("开始校验新增/导入/导出按钮可见性")
        content_frame = page.locator("iframe[name=\"supos-tab-framework-3\"]").content_frame
        expect(content_frame.get_by_role("button", name="plus-circle 新增")).to_be_visible()
        expect(content_frame.get_by_role("button", name="import 导入")).to_be_visible()
        expect(content_frame.get_by_role("button", name="export 导出")).to_be_visible()
        
        logger.info("所有按钮校验通过，用例执行完成")
