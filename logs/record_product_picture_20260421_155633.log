from playwright.sync_api import Playwright, sync_playwright, expect


def run(playwright: Playwright) -> None:
    browser = playwright.chromium.launch(headless=False)
    context = browser.new_context(ignore_https_errors=True)
    page = context.new_page()
    page.goto("https://test2.saas-test3.supcon.com:32188/login#/login")
    page.get_by_role("textbox", name="请输入用户名").click()
    page.get_by_role("textbox", name="请输入用户名").fill("admin")
    page.get_by_role("textbox", name="请输入密码").click()
    page.get_by_role("textbox", name="请输入密码").fill("Supcon1304@")
    page.get_by_role("button", name="登 录").click()
    page.get_by_text("基础资料").click()
    page.get_by_text("产品档案").click()
    page.locator("iframe[name=\"supos-tab-framework-2\"]").content_frame.get_by_role("button", name="plus-circle 新增").click()
    page.locator("iframe[name=\"supos-tab-framework-2\"]").content_frame.get_by_label("创建产品").get_by_text("产品图片").click()
    expect(page.locator("iframe[name=\"supos-tab-framework-2\"]").content_frame.locator("div").filter(has_text=re.compile(r"^产品图片上传$")).first).to_be_visible()
    page.locator("iframe[name=\"supos-tab-framework-2\"]").content_frame.get_by_role("button", name="plus 上传").nth(1).click()
    page.locator("iframe[name=\"supos-tab-framework-2\"]").content_frame.get_by_role("button", name="plus 上传").first.set_input_files("1.png")
    page.locator("iframe[name=\"supos-tab-framework-2\"]").content_frame.get_by_role("link", name="eye").click()
    expect(page.locator("iframe[name=\"supos-tab-framework-2\"]").content_frame.locator("div").filter(has_text=re.compile(r"^1\.png$")).nth(4)).to_be_visible()
    expect(page.locator("iframe[name=\"supos-tab-framework-2\"]").content_frame.get_by_role("dialog", name="1.png").get_by_label("Close", exact=True)).to_be_visible()
    expect(page.locator("iframe[name=\"supos-tab-framework-2\"]").content_frame.get_by_role("dialog", name="1.png").get_by_label("Close", exact=True)).to_be_visible()
    expect(page.locator("iframe[name=\"supos-tab-framework-2\"]").content_frame.get_by_role("dialog", name="1.png").get_by_label("Close", exact=True)).to_be_visible()
    expect(page.locator("iframe[name=\"supos-tab-framework-2\"]").content_frame.locator("div:nth-child(6) > .ant-modal-root > .ant-modal-wrap > .ant-modal > .ant-modal-content > .ant-modal-body")).to_be_visible()
    page.locator("iframe[name=\"supos-tab-framework-2\"]").content_frame.get_by_role("dialog", name="1.png").get_by_label("Close", exact=True).click()
    page.locator("iframe[name=\"supos-tab-framework-2\"]").content_frame.locator("div").filter(has_text=re.compile(r"^产品图片1\.png上传$")).first.click()
    page.locator("iframe[name=\"supos-tab-framework-2\"]").content_frame.get_by_role("button", name="delete").click()
    page.close()

    # ---------------------
    context.close()
    browser.close()


with sync_playwright() as playwright:
    run(playwright)

