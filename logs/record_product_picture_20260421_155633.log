import pytest
from playwright.sync_api import Page, expect
from src.base.base_test import BaseTest
from src.common.logger import logger

class TestProductPicture(BaseTest):
    """
    用例名：product_picture
    用例ms的id：0
    """

    def test_product_picture(self, page: Page, project_name: str):
        f"""测试产品图片上传预览删除功能
        用例名：product_picture
        用例ms的id：0
        项目名：{project_name}

        Args:
            page: 页面实例
            project_name: 项目名称
        """
        logger.info("=" * 60)
        logger.info(f"开始执行用例：product_picture")
        logger.info(f"用例ms的id：0")
        logger.info("=" * 60)
        
        # 调用公用登录方法
        logger.info("登录系统")
        self.login(page, project_name)
        
        # 进入产品档案模块
        logger.info("进入产品档案页面")
        page.get_by_text("基础资料").click()
        page.get_by_text("产品档案").click()
        
        # 获取iframe上下文，简化后续代码
        product_frame = page.locator("iframe[name=\"supos-tab-framework-2\"]").content_frame
        
        # 点击新增产品
        logger.info("点击新增产品按钮")
        product_frame.get_by_role("button", name="plus-circle 新增").click()
        
        # 打开产品图片上传区域
        logger.info("进入产品图片上传环节")
        product_frame.get_by_label("创建产品").get_by_text("产品图片").click()
        expect(product_frame.locator("div").filter(has_text=re.compile(r"^产品图片上传$")).first).to_be_visible()
        
        # 上传测试图片
        logger.info("上传测试图片文件1.png")
        product_frame.get_by_role("button", name="plus 上传").nth(1).click()
        product_frame.get_by_role("button", name="plus 上传").first.set_input_files("1.png")
        
        # 预览上传的图片
        logger.info("预览上传的图片")
        product_frame.get_by_role("link", name="eye").click()
        
        # 断言预览功能正常
        logger.info("验证图片预览显示正确")
        expect(product_frame.locator("div").filter(has_text=re.compile(r"^1\.png$")).nth(4)).to_be_visible()
        expect(product_frame.get_by_role("dialog", name="1.png").get_by_label("Close", exact=True)).to_be_visible()
        expect(product_frame.locator("div:nth-child(6) > .ant-modal-root > .ant-modal-wrap > .ant-modal > .ant-modal-content > .ant-modal-body")).to_be_visible()
        
        # 关闭预览弹窗
        logger.info("关闭图片预览弹窗")
        product_frame.get_by_role("dialog", name="1.png").get_by_label("Close", exact=True).click()
        
        # 删除测试图片
        logger.info("删除上传的测试图片")
        product_frame.locator("div").filter(has_text=re.compile(r"^产品图片1\.png上传$")).first.click()
        product_frame.get_by_role("button", name="delete").click()
        
        logger.info("用例product_picture执行完成")
