    page.get_by_role("textbox", name="请输入密码").click()
    page.get_by_role("textbox", name="请输入密码").click()
    page.get_by_role("textbox", name="请输入密码").fill("Supcon1304@")
    page.get_by_role("button", name="登 录").click()
    page.get_by_text("基础资料").click()
    page.get_by_text("产品档案").click()
    page.locator("iframe[name=\"supos-tab-framework-2\"]").content_frame.get_by_role("button", name="plus-circle 新增").click()
    expect(page.locator("iframe[name=\"supos-tab-framework-2\"]").content_frame.get_by_text("基础信息产品编码产品名称产品规格产品型号单位千克产品属性产品类型产品来源自制标准工时小时分秒产品有效期保质期天最高库存最低库存预警期天工艺路线备注产品图片上传启")).to_be_visible()
    expect(page.locator("iframe[name=\"supos-tab-framework-2\"]").content_frame.get_by_label("创建产品").get_by_text("标准工时")).to_be_visible()
    expect(page.locator("iframe[name=\"supos-tab-framework-2\"]").content_frame.locator("div").filter(has_text=re.compile(r"^标准工时小时分秒$")).first).to_be_visible()
    page.locator("iframe[name=\"supos-tab-framework-2\"]").content_frame.get_by_role("spinbutton").first.click()
