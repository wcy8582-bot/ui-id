import pytest
from playwright.sync_api import Page, expect
from src.base.base_test import BaseTest
from src.common.logger import logger

class TestVerifyCreateCodeRule(BaseTest):
    """
    用例名：verify_create_button
    用例ms的id：0
    """

    def test_verify_create_button(self, page: Page, project_name: str):
        f"""测试编码规则创建功能
        用例名：verify_create_button
        用例ms的id：0
        项目名：{project_name}

        Args:
            page: 页面实例
            project_name: 项目名称
        """
        logger.info("=" * 60)
        logger.info(f"开始执行用例：verify_create_button")
        logger.info(f"用例ms的id：0")
        logger.info("=" * 60)
        
        # 调用公用登录方法
        self.login(page, project_name)
        logger.info("登录成功，进入编码规则配置菜单")

        # 进入功能页面
        page.get_by_text("基础资料").click()
        page.get_by_text("编码规则配置").click()
        # 提取iframe内容帧，避免重复定位
        frame = page.locator("iframe[name=\"supos-tab-framework-2\"]").content_frame
        
        logger.info("点击创建按钮，开始新增编码规则")
        frame.get_by_role("button", name="plus-circle 创建").click()

        # 填写规则基础信息
        logger.info("填写编码规则基础信息")
        frame.get_by_role("textbox", name="请输入规则编码，忽略将自动生成").click()
        frame.get_by_role("textbox", name="请输入规则编码，忽略将自动生成").fill("AA00006")
        
        frame.get_by_role("textbox", name="请输入规则名称").click()
        frame.get_by_role("textbox", name="请输入规则名称").fill("1")
        
        frame.get_by_role("dialog", name="新增编码规则").locator("#businessTypeId").click()
        frame.get_by_text("生产工单批号").nth(3).click()

        # 配置规则段
        logger.info("添加规则段配置")
        frame.get_by_role("button", name="plus-circle 增行").click()
        frame.locator("#rc_select_4").click()
        frame.get_by_text("日期时间").click()
        frame.locator("#rc_select_6").click()
        frame.get_by_text("yyyy").nth(2).click()

        # 修改编码后重新保存
        logger.info("保存编码规则")
        frame.get_by_role("button", name="保 存").click()
        frame.get_by_role("textbox", name="请输入规则编码，忽略将自动生成").click()
        frame.get_by_role("textbox", name="请输入规则编码，忽略将自动生成").fill("AA00001")
        frame.get_by_role("button", name="保 存").click()

        # 执行停用操作
        logger.info("对创建的规则执行停用操作")
        frame.get_by_role("cell", name="AA00001").click()
        frame.get_by_role("cell", name="停用").first.click()

        logger.info("用例verify_create_button执行完成")
