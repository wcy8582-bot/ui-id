    expect(page.locator("iframe[name=\"supos-tab-framework-2\"]").content_frame.get_by_text("编辑").nth(5)).to_be_visible()
    page.locator("iframe[name=\"supos-tab-framework-2\"]").content_frame.get_by_text("编辑").nth(5).click()
