import pytest
from playwright.sync_api import Page, expect
from src.base.base_test import BaseTest
from src.common.logger import logger

class TestVerifyAddChildProduct(BaseTest):
    """
    用例名：verify_add_child_product
    用例ms的id：0
    """

    def test_verify_add_child_product(self, page: Page, project_name: str):
        f"""测试BOM添加子项产品功能
        用例名：verify_add_child_product
        用例ms的id：0
        项目名：{project_name}

        Args:
            page: 页面实例
            project_name: 项目名称
        """
        logger.info("=" * 60)
        logger.info(f"开始执行用例：verify_add_child_product")
        logger.info(f"用例ms ID：0")
        logger.info("=" * 60)
        
        # 使用封装好的公用登录方法
        logger.info("执行系统登录")
        self.login(page, project_name)
        
        # 进入物料清单菜单
        logger.info("进入物料清单页面")
        page.get_by_text("基础资料").click()
        page.get_by_text("物料清单").click()
        
        # 获取BOM页面iframe上下文
        bom_iframe = page.locator("iframe[name=\"supos-tab-framework-2\"]").content_frame
        
        # 验证目标物料和编辑按钮可见
        logger.info("验证目标物料行和编辑按钮可见")
        expect(bom_iframe.get_by_role("row", name="6 CP2026042000039 自行车 - 自制 辆").locator("a")).to_be_visible()
        expect(bom_iframe.get_by_text("编辑").nth(5)).to_be_visible()
        
        # 打开编辑页面
        logger.info("点击编辑按钮")
        bom_iframe.get_by_text("编辑").nth(5).click()
        
        # 点击添加子项产品按钮
        logger.info("触发添加子项产品操作")
        expect(bom_iframe.get_by_role("button", name="plus-circle 添加子项产品")).to_be_visible()
        bom_iframe.get_by_role("button", name="plus-circle 添加子项产品").click()
        
        # 勾选待添加的子项产品
        logger.info("勾选目标子项产品")
        bom_iframe.get_by_role("row", name="CP2026042200009 笔记本116").get_by_label("", exact=True).check()
        
        # 确认选择
        logger.info("确认选择的子项产品")
        bom_iframe.get_by_role("button", name="选 择").click()
        
        # 保存修改
        logger.info("保存BOM修改")
        bom_iframe.get_by_role("button", name="保 存").click()
        
        # 验证新增子项添加成功
        logger.info("验证新增子项存在")
        bom_iframe.get_by_role("button", name="holder 3 CP2026042000044 踏板").click()
        
        logger.info("用例verify_add_child_product执行完成")
