from playwright.sync_api import Playwright, sync_playwright, expect


def run(playwright: Playwright) -> None:
    browser = playwright.chromium.launch(headless=False)
    context = browser.new_context(ignore_https_errors=True)
    page = context.new_page()
    page.goto("https://test2.saas-test3.supcon.com:32188/login#/login")
    page.get_by_role("textbox", name="请输入用户名").click()
    page.get_by_role("textbox", name="请输入用户名").fill("admin")
    page.get_by_role("textbox", name="请输入密码").click()
    page.get_by_role("textbox", name="请输入密码").fill("Supcon1304@")
    page.get_by_role("button", name="登 录").click()
    page.get_by_role("button", name="确定").click()
    page.get_by_text("基础资料").click()
    page.get_by_text("产品档案").click()
    expect(page.locator("iframe[name=\"supos-tab-framework-2\"]").content_frame.locator("thead")).to_contain_text("序号")
    expect(page.locator("iframe[name=\"supos-tab-framework-2\"]").content_frame.locator("thead")).to_contain_text("产品编码")
    expect(page.locator("iframe[name=\"supos-tab-framework-2\"]").content_frame.locator("thead")).to_contain_text("产品名称")
    expect(page.locator("iframe[name=\"supos-tab-framework-2\"]").content_frame.locator("thead")).to_contain_text("产品规格")
    expect(page.locator("iframe[name=\"supos-tab-framework-2\"]").content_frame.locator("thead")).to_contain_text("产品图片")
    expect(page.locator("iframe[name=\"supos-tab-framework-2\"]").content_frame.locator("thead")).to_contain_text("产品型号")
    expect(page.locator("iframe[name=\"supos-tab-framework-2\"]").content_frame.locator("thead")).to_contain_text("操作")
    expect(page.locator("iframe[name=\"supos-tab-framework-2\"]").content_frame.get_by_text("编辑").first).to_be_visible()
    expect(page.locator("iframe[name=\"supos-tab-framework-2\"]").content_frame.get_by_text("复制").first).to_be_visible()
    expect(page.locator("iframe[name=\"supos-tab-framework-2\"]").content_frame.get_by_text("删除").first).to_be_visible()
    expect(page.get_by_title("退出")).to_be_visible()
    page.close()

    # ---------------------
    context.close()
    browser.close()


with sync_playwright() as playwright:
    run(playwright)

