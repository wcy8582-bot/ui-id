    """

    def test_verify_whether_field(self, page: Page, project_name: str):
        f"""测试编码规则配置功能
        用例名：verify_whether_field
        用例ms的id：0
        项目名：{project_name}

        Args:
            page: 页面实例
            project_name: 项目名称
        """
        logger.info("=" * 60)
