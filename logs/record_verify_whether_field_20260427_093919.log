        frame.get_by_text("生产工单批号").nth(4).click()
        
        # 添加规则段并处理多余项
        logger.info("新增规则段并清理多余项")
        frame.get_by_role("button", name="plus-circle 增行").click()
        frame.locator("#rc_select_4").click()
        frame.get_by_text("日期时间").click()
