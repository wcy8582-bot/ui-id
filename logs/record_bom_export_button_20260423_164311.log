import pytest
from playwright.sync_api import Playwright, sync_playwright, expect, Page
from src.base.base_test import BaseTest
from src.common.logger import logger


class TestBomExportButton(BaseTest):
    """
    用例名：bom_export_button
    用例ms的id：0
    """

    def test_bom_export_button(self, page: Page, project_name: str):
        f"""测试BOM导出功能
        用例名：bom_export_button
        用例ms的id：0
        项目名：{project_name}

        Args:
            page: 页面实例
            project_name: 项目名称
        """
        logger.info("=" * 60)
        logger.info(f"开始执行用例：bom_export_button")
        logger.info(f"用例ms的id：0")
        logger.info("=" * 60)
        
        # 使用公用登录方法登录系统
        logger.info("登录系统")
        self.login(page, project_name)
        
        # 导航进入物料清单页面
        logger.info("进入物料清单页面")
        page.get_by_text("基础资料").click()
        page.get_by_text("物料清单").click()

        # 获取目标iframe内容上下文
        export_frame = page.locator("iframe[name=\"supos-tab-framework-2\"]").content_frame
        logger.info("开始执行导出配置操作")
        # 点击打开导出弹窗
        export_frame.get_by_role("button", name="export 导出").click()
        # 选择导出范围为选中页面
        export_frame.get_by_role("radio", name="选中页面范围").check()
        # 设置导出结束页码
        export_frame.get_by_role("spinbutton").nth(1).click()
        export_frame.get_by_role("spinbutton").nth(1).fill("3")
        export_frame.locator("div").filter(has_text="文件名：导出数据范围：选中页面范围全部数据 — （请输入页码范围（例如：1-3））").nth(5).click()
        
        # 触发导出下载
        logger.info("触发导出，等待下载完成")
        with page.expect_download() as download_info:
            export_frame.get_by_role("button", name="导 出").click()
        download = download_info.value
        logger.info(f"导出文件下载完成，文件名：{download.suggested_filename}")
        
        # 确认导出成功提示
        export_frame.get_by_text("导出成功").click()
        logger.info("bom_export_button用例执行完成")
