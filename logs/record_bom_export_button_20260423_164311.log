from playwright.sync_api import Playwright, sync_playwright, expect


def run(playwright: Playwright) -> None:
    browser = playwright.chromium.launch(headless=False)
    context = browser.new_context(ignore_https_errors=True)
    page = context.new_page()
    page.goto("https://test2.saas-test3.supcon.com:32188/login#/login")
    page.get_by_role("textbox", name="请输入用户名").click()
    page.get_by_role("textbox", name="请输入用户名").fill("admin")
    page.get_by_role("textbox", name="请输入密码").click()
    page.get_by_role("textbox", name="请输入密码").fill("Supcon1304@")
    page.get_by_role("button", name="登 录").click()
    page.get_by_text("基础资料").click()
    page.get_by_text("物料清单").click()
    page.locator("iframe[name=\"supos-tab-framework-2\"]").content_frame.get_by_role("button", name="export 导出").click()
    page.locator("iframe[name=\"supos-tab-framework-2\"]").content_frame.get_by_role("radio", name="选中页面范围").check()
    page.locator("iframe[name=\"supos-tab-framework-2\"]").content_frame.get_by_role("spinbutton").nth(1).click()
    page.locator("iframe[name=\"supos-tab-framework-2\"]").content_frame.get_by_role("spinbutton").nth(1).fill("3")
    page.locator("iframe[name=\"supos-tab-framework-2\"]").content_frame.locator("div").filter(has_text="文件名：导出数据范围：选中页面范围全部数据 — （请输入页码范围（例如：1-3））").nth(5).click()
    with page.expect_download() as download_info:
        page.locator("iframe[name=\"supos-tab-framework-2\"]").content_frame.get_by_role("button", name="导 出").click()
    download = download_info.value
    page.locator("iframe[name=\"supos-tab-framework-2\"]").content_frame.get_by_text("导出成功").click()
    page.close()

    # ---------------------
    context.close()
    browser.close()


with sync_playwright() as playwright:
    run(playwright)

