import pytest
from playwright.sync_api import Page, expect
from src.base.base_test import BaseTest
from src.common.logger import logger

class TestVerifyImport(BaseTest):
    """
    用例名：verify_import
    用例ms的id：0
    """

    def test_verify_import(self, page: Page, project_name: str):
        f"""测试客户档案导入功能
        用例名：verify_import
        用例ms的id：0
        项目名：{project_name}

        Args:
            page: 页面实例
            project_name: 项目名称
        """
        logger.info("=" * 60)
        logger.info(f"开始执行用例：verify_import")
        logger.info(f"用例ms的id：0")
        logger.info("=" * 60)
        
        # 使用封装好的公用登录方法登录系统
        logger.info("调用公用登录方法完成登录")
        self.login(page, project_name)
        
        # 导航进入客户档案页面
        logger.info("导航进入客户档案页面")
        page.get_by_text("基础资料").click()
        page.get_by_text("物料清单").click()
        page.get_by_text("客户档案").click()

        # 获取客户档案iframe上下文，简化后续定位
        client_frame = page.locator("iframe[name=\"supos-tab-framework-3\"]").content_frame
        
        # 点击打开导入弹窗
        logger.info("打开导入弹窗")
        expect(client_frame.get_by_role("button", name="import 导入").first).to_be_visible()
        client_frame.get_by_role("button", name="import 导入").first.click()
        
        # 选择导入文件
        logger.info("上传待导入的客户资料文件")
        client_frame.get_by_text("文件选择模板下载").click()
        file_input = client_frame.get_by_role("button").filter(has_text=re.compile(r"^$")).nth(5)
        file_input.click()
        file_input.set_input_files("客户资料_2026_04_24.xls")

        # 确认导入
        logger.info("确认执行导入操作")
        client_frame.get_by_text("文件选择模板下载操作模式更新并新增导入说明:1.仅支持").click()
        client_frame.get_by_role("button", name="确 认").click()
        
        # 验证导入启动成功
        logger.info("验证导入开始提示可见，断言成功")
        expect(client_frame.get_by_text("[2026-04-24 09:37:14 206] - 导入开始 [2026-04-24 09:37:14 260] - 校验开始（1/1） [2026-04")).to_be_visible()
        
        # 关闭弹窗，结束用例
        logger.info("关闭导入结果弹窗，用例执行完成")
        client_frame.get_by_role("button", name="关 闭").click()
