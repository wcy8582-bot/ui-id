import pytest
from playwright.sync_api import Page, expect
from src.base.base_test import BaseTest
from src.common.logger import logger

class TestVerifyEnabledRuleEffect(BaseTest):
    """
    用例名：test_verify_enabled_rule_effect
    用例ms的id：0
    """

    def test_verify_enabled_rule_effect(self, page: Page, project_name: str):
        f"""测试编码规则新增功能
        用例名：test_verify_enabled_rule_effect
        用例ms的id：0
        项目名：{project_name}

        Args:
            page: 页面实例
            project_name: 项目名称
        """
        logger.info("=" * 60)
        logger.info(f"开始执行用例test_verify_enabled_rule_effect")
        logger.info(f"用例ms的id：0")
        logger.info("=" * 60)
        
        # 调用公用登录方法
        self.login(page, project_name)
        
        # 进入编码规则配置菜单
        logger.info("进入编码规则配置页面")
        page.get_by_text("基础资料").click()
        page.get_by_text("编码规则配置").click()
        
        # 获取目标iframe，简化后续定位
        logger.info("获取功能页iframe实例")
        rule_frame = page.locator("iframe[name=\"supos-tab-framework-2\"]").content_frame
        
        # 打开新增编码规则弹窗
        logger.info("点击创建按钮，打开新增编码规则弹窗")
        rule_frame.get_by_role("button", name="plus-circle 创建").click()
        
        # 选择业务类型
        logger.info("选择业务类型为托码")
        rule_frame.get_by_role("dialog", name="新增编码规则").locator("#businessTypeId").click()
        rule_frame.get_by_text("托码").nth(1).click()
        
        # 新增规则行并选择规则类型
        logger.info("新增规则行，选择规则类型为固定值")
        rule_frame.get_by_role("button", name="plus-circle 增行").click()
        rule_frame.locator("#rc_select_4").click()
        rule_frame.get_by_text("固定值").click()
        
        # 删除原有多余行（去除录制重复误操作，保留删除核心逻辑）
        logger.info("删除所有已有多余行")
        delete_btns = rule_frame.get_by_role("button", name="holder 固定值 是 删除")
        while delete_btns.count() > 0:
            delete_btns.first.click()
        
        logger.info("用例执行完成，关闭页面")
        page.close()
