import pytest
from playwright.sync_api import Page, expect
from src.base.base_test import BaseTest
from src.common.logger import logger

class TestVerifyBomTemplateReset(BaseTest):
    """
    用例名：verify_bom_template_reset
    用例ms的id：0
    """

    def test_verify_bom_template_reset(self, page: Page, project_name: str):
        f"""测试BOM模板重置功能
        用例名：verify_bom_template_reset
        用例ms的id：0
        项目名：{project_name}

        Args:
            page: 页面实例
            project_name: 项目名称
        """
        logger.info("=" * 60)
        logger.info(f"开始执行用例：verify_bom_template_reset")
        logger.info(f"用例ms的id：0")
        logger.info("=" * 60)
        
        # 使用封装好的公用登录方法完成登录
        self.login(page, project_name)
        
        # 导航进入物料清单页面
        logger.info("进入物料清单模块")
        page.get_by_text("基础资料").click()
        page.get_by_text("物料清单").click()
        
        # 获取物料清单页面所在iframe内容框架
        bom_iframe_frame = page.locator("iframe[name=\"supos-tab-framework-2\"]").content_frame
        
        # 验证物料清单页面加载完成
        expect(bom_iframe_frame.get_by_text("父项产品编码父项产品名称父项产品规格子项产品编码子项产品名称子项产品规格父项产品来源请选择父项产品来源子项产品来源请选择子项产品属来源查 询重 置")).to_be_visible()
        
        # 输入测试查询条件，去除录制产生的多余重复按键、填充操作
        logger.info("输入测试父项产品编码")
        input_elem = bom_iframe_frame.get_by_role("textbox", name="父项产品编码 :")
        input_elem.click()
        input_elem.fill("FJ00001")
        
        # 点击重置按钮
        logger.info("点击重置按钮，验证重置功能")
        bom_iframe_frame.get_by_role("button", name="重 置").click()
        
        # 验证重置后页面恢复初始状态，功能正常
        expect(bom_iframe_frame.get_by_text("父项产品编码父项产品名称父项产品规格子项产品编码子项产品名称子项产品规格父项产品来源请选择父项产品来源子项产品来源请选择子项产品属来源查 询重 置")).to_be_visible()
        
        logger.info(f"用例verify_bom_template_reset执行完成")
