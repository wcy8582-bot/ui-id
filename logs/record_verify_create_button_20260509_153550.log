    page.locator("iframe[name=\"supos-tab-framework-2\"]").content_frame.get_by_role("textbox", name="请输入规则名称").click()
    page.locator("iframe[name=\"supos-tab-framework-2\"]").content_frame.get_by_role("textbox", name="请输入规则名称").fill("q")
    page.locator("iframe[name=\"supos-tab-framework-2\"]").content_frame.get_by_label("新增编码规则").get_by_text("业务类型", exact=True).click()
    page.locator("iframe[name=\"supos-tab-framework-2\"]").content_frame.get_by_role("dialog", name="新增编码规则").locator("#businessTypeId").click()
    page.locator("iframe[name=\"supos-tab-framework-2\"]").content_frame.get_by_text("生产工单批号").nth(2).click()
    page.locator("iframe[name=\"supos-tab-framework-2\"]").content_frame.get_by_role("button", name="plus-circle 增行").click()
    page.locator("iframe[name=\"supos-tab-framework-2\"]").content_frame.locator("#rc_select_4").click()
    page.locator("iframe[name=\"supos-tab-framework-2\"]").content_frame.get_by_text("日期时间").click()
    page.locator("iframe[name=\"supos-tab-framework-2\"]").content_frame.locator("#rc_select_6").click()
