        bom_frame.get_by_role("button", name="查 询").click()

        # 按子项产品名称查询
        logger.info("输入子项产品名称并查询")
        bom_frame.get_by_role("textbox", name="子项产品名称 :").click()
        bom_frame.get_by_role("textbox", name="子项产品名称 :").fill("allen-物料02")
        bom_frame.get_by_role("button", name="查 询").click()

        # 按子项产品来源查询
