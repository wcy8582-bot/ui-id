    """

    def test_bom_check_child(self, page: Page, project_name: str):
        f"""测试BOM子项查询功能
        用例名：bom_check_child
        用例ms的id：0
        项目名：{project_name}

        Args:
            page: 页面实例
            project_name: 项目名称
        """
        logger.info("=" * 60)
        logger.info(f"开始执行用例：bom_check_child")
        logger.info(f"用例ms的id：0")
        logger.info("=" * 60)
        
        # 使用封装好的公用登录方法
        self.login(page, project_name)

        # 进入物料清单模块
        logger.info("进入物料清单页面")
        page.get_by_text("基础资料").click()
        page.get_by_text("物料清单").click()

        # 复用iframe帧对象，减少重复定位
        logger.info("定位BOM查询页面iframe")
        bom_frame = page.locator("iframe[name=\"supos-tab-framework-2\"]").content_frame

