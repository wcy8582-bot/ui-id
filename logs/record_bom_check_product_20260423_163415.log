import pytest
from playwright.sync_api import Page, expect
from src.base.base_test import BaseTest
from src.common.logger import logger


class TestBomCheckProduct(BaseTest):
    """
    用例名：bom_check_product
    用例ms的id：0
    """

    def test_bom_check_product(self, page: Page, project_name: str):
        f"""测试BOM物料清单产品查询功能
        用例名：bom_check_product
        用例ms的id：0
        项目名：{project_name}

        Args:
            page: 页面实例
            project_name: 项目名称
        """
        logger.info("=" * 60)
        logger.info(f"开始执行测试用例：bom_check_product")
        logger.info(f"用例ms的id：0")
        logger.info("=" * 60)
        
        # 使用封装好的公用登录方法登录系统
        self.login(page, project_name)
        logger.info("系统登录成功，开始进入业务模块")
        
        # 导航进入物料清单页面
        logger.info("进入基础资料->物料清单模块")
        page.get_by_text("基础资料").click()
        page.get_by_text("物料清单").click()
        
        # 提取iframe内容帧，统一帧上下文操作，简化代码
        bom_frame = page.locator("iframe[name=\"supos-tab-framework-2\"]").content_frame
        
        # 按父项产品编码查询
        logger.info("输入父项产品编码执行查询")
        bom_frame.get_by_role("textbox", name="父项产品编码 :").click()
        bom_frame.get_by_role("textbox", name="父项产品编码 :").press("CapsLock")
        bom_frame.get_by_role("textbox", name="父项产品编码 :").fill("FJ00001")
        bom_frame.get_by_role("button", name="查 询").click()
        
        # 按子项产品名称二次查询
        logger.info("输入子项产品名称执行二次查询")
        bom_frame.locator("img").click()
        bom_frame.get_by_role("textbox", name="子项产品名称 :").click()
        bom_frame.get_by_role("textbox", name="子项产品名称 :").press("CapsLock")
        bom_frame.get_by_role("textbox", name="子项产品名称 :").fill("PJ00184")
        bom_frame.get_by_role("button", name="查 询").click()
        
        # 点击暂无数据后重置查询条件，完成测试
        bom_frame.locator("div").filter(has_text=re.compile(r"^暂无数据$")).first.click()
        bom_frame.get_by_role("button", name="重 置").click()
        logger.info("测试用例bom_check_product执行完成")
