    expect(page.locator("iframe[name=\"supos-tab-framework-2\"]").content_frame.get_by_text("添加子项产品序号物料编号物料名称物料规格单位用量关联工序单位物料来源库存数量备注操作 1PJ00184镜腿套-海伦凯勒中号委外工序采购wbb1副委外删除 To")).to_be_visible()
    page.close()

    # ---------------------
