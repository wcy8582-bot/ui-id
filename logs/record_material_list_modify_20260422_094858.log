import pytest
from playwright.sync_api import Page, expect
from src.base.base_test import BaseTest
from src.common.logger import logger

class TestMaterialListModify(BaseTest):
    """
    用例名：material_list_modify
    用例ms的id：0
    """

    def test_material_list_modify(self, page: Page, project_name: str):
        f"""测试查看物料清单详情功能
        用例名：material_list_modify
        用例ms的id：0
        项目名：{project_name}

        Args:
            page: 页面实例
            project_name: 项目名称
        """
        logger.info("=" * 60)
        logger.info(f"开始执行用例：material_list_modify")
        logger.info(f"用例ms的id：0")
        logger.info("=" * 60)
        
        # 使用封装好的公用方法完成登录
        self.login(page, project_name)
        logger.info("登录成功，开始导航到物料清单页面")

        # 打开菜单进入物料清单页面
        page.get_by_text("基础资料").click()
        page.get_by_text("物料清单").click()

        # 获取目标iframe，简化后续重复代码
        content_iframe = page.locator("iframe[name=\"supos-tab-framework-2\"]").content_frame
        logger.info("验证目标物料存在，打开物料详情")

        # 核心操作：点击目标物料进入详情
        expect(content_iframe.get_by_role("cell", name="CP2026042000050")).to_be_visible()
        content_iframe.get_by_role("cell", name="CP2026042000050").locator("a").click()

        # 断言详情页所有关键信息展示正常
        logger.info("开始验证物料详情弹窗各项信息")
        expect(content_iframe.locator("div").filter(has_text="父项产品信息父项产品wt").nth(5)).to_be_visible()
        expect(content_iframe.get_by_role("dialog", name="查看物料清单").locator("form")).to_be_visible()
        expect(content_iframe.get_by_text("子项产品信息")).to_be_visible()
        expect(content_iframe.get_by_text("添加子项产品序号物料编号物料名称物料规格单位用量关联工序单位物料来源库存数量备注操作 1PJ00184镜腿套-海伦凯勒中号委外工序采购wbb1副委外删除 To")).to_be_visible()
        expect(content_iframe.locator("div").filter(has_text=re.compile(r"^父项产品wt自行车$")).first).to_be_visible()
        expect(content_iframe.get_by_title("自制")).to_be_visible()
        expect(content_iframe.locator("div").filter(has_text=re.compile(r"^工艺路线$")).first).to_be_visible()
        expect(content_iframe.locator("div").filter(has_text=re.compile(r"^单位$")).first).to_be_visible()
        expect(content_iframe.locator("div").filter(has_text=re.compile(r"^产品规格$")).first).to_be_visible()
        expect(content_iframe.locator("div").filter(has_text=re.compile(r"^物料来源自制$")).first).to_be_visible()
        
        logger.info("所有断言验证通过，用例执行完成")
