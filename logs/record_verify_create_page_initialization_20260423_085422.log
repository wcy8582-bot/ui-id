import pytest
from playwright.sync_api import Page, expect
from src.base.base_test import BaseTest
from src.common.logger import logger


class TestVerifyCreateBomPageInitialization(BaseTest):
    """
    用例名：verify_create_page_initialization
    用例ms的id：0
    """

    def test_verify_create_page_initialization(self, page: Page, project_name: str):
        f"""验证物料清单创建页面初始化元素显示正确
        用例名：verify_create_page_initialization
        用例ms的id：0
        项目名：{project_name}

        Args:
            page: 页面实例
            project_name: 项目名称
        """
        logger.info("=" * 60)
        logger.info(f"开始执行用例：verify_create_page_initialization")
        logger.info(f"用例ms ID：0")
        logger.info("=" * 60)
        
        # 使用封装好的公用方法登录系统
        self.login(page, project_name)
        logger.info("登录成功，进入菜单导航")

        # 进入物料清单功能页面
        logger.info("点击基础资料菜单")
        page.get_by_text("基础资料").click()
        logger.info("点击物料清单菜单")
        page.get_by_text("物料清单").click()

        # 获取物料清单页面的iframe内容帧
        bom_frame = page.locator("iframe[name=\"supos-tab-framework-2\"]").content_frame
        expect(bom_frame.get_by_role("button", name="plus-circle 新增")).to_be_visible()
        
        # 点击新增按钮打开创建页面
        logger.info("点击新增按钮，打开创建物料清单页面")
        bom_frame.get_by_role("button", name="plus-circle 新增").click()

        # 验证创建页面核心模块元素可见
        logger.info("开始验证创建页面初始化元素")
        expect(bom_frame.get_by_text("创建物料清单")).to_be_visible()
        expect(bom_frame.get_by_text("父项产品信息父项产品请选择产品产品规格物料来源工艺路线单位子项产品信息添加子项产品序号物料编号物料名称物料规格单位用量关联工序单位物料来源库存数量备注操作 暂无")).to_be_visible()
        expect(bom_frame.get_by_text("父项产品信息")).to_be_visible()
        expect(bom_frame.get_by_text("父项产品请选择产品产品规格物料来源工艺路线单位")).to_be_visible()
        expect(bom_frame.get_by_text("子项产品信息")).to_be_visible()
        expect(bom_frame.locator("div").filter(has_text=re.compile(r"^添加子项产品$"))).to_be_visible()
        
        # 验证子项表格表头字段完整正确
        create_form = bom_frame.get_by_label("创建物料清单")
        expect(create_form.locator("thead")).to_contain_text("序号")
        expect(create_form.locator("thead")).to_contain_text("物料编号")
        expect(create_form.locator("thead")).to_contain_text("物料名称")
        expect(create_form.locator("thead")).to_contain_text("物料规格")
        expect(create_form.locator("thead")).to_contain_text("单位用量")
        expect(create_form.locator("thead")).to_contain_text("关联工序")
        expect(create_form.locator("thead")).to_contain_text("单位")
        expect(create_form.locator("thead")).to_contain_text("物料来源")
        expect(create_form.locator("thead")).to_contain_text("库存数量")
        expect(create_form.locator("thead")).to_contain_text("备注")
        expect(create_form.locator("thead")).to_contain_text("操作")
        
        logger.info("所有初始化元素验证通过，用例执行完成")
