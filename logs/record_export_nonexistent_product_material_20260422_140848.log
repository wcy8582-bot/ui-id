import pytest
from playwright.sync_api import Page, expect
from src.base.base_test import BaseTest
from src.common.logger import logger

class TestExportNonexistentProductMaterial(BaseTest):
    """
    用例名：export_nonexistent_product_material
    用例ms的id：0
    """

    def test_export_nonexistent_product_material(self, page: Page, project_name: str):
        f"""测试导出不存在产品的物料清单
        用例名：export_nonexistent_product_material
        用例ms的id：0
        项目名：{project_name}

        Args:
            page: 页面实例
            project_name: 项目名称
        """
        logger.info("=" * 60)
        logger.info(f"开始执行用例：export_nonexistent_product_material")
        logger.info(f"用例ms ID：0")
        logger.info("=" * 60)
        
        # 使用公用登录方法登录系统
        logger.info("调用公用登录方法完成登录")
        self.login(page, project_name)
        
        # 导航到物料清单页面
        logger.info("进入基础资料->物料清单页面")
        page.get_by_text("基础资料").click()
        page.get_by_text("物料清单").click()

        # 获取目标iframe内容帧，简化后续代码
        bom_frame = page.locator("iframe[name=\"supos-tab-framework-2\"]").content_frame

        # 输入查询条件
        logger.info("输入查询条件：父项产品编码 FJ00002")
        bom_frame.locator("div").filter(has_text=re.compile(r"^父项产品编码$")).nth(2).click()
        expect(bom_frame.locator("div").filter(has_text=re.compile(r"^父项产品编码$")).nth(2)).to_be_visible()
        bom_frame.get_by_role("textbox", name="父项产品编码 :").click()
        bom_frame.get_by_role("textbox", name="父项产品编码 :").fill("FJ00002")

        # 执行查询
        logger.info("点击查询按钮")
        bom_frame.get_by_role("button", name="查 询").click()

        # 验证暂无数据结果
        logger.info("验证查询结果显示暂无数据")
        bom_frame.locator("div").filter(has_text=re.compile(r"^暂无数据$")).first.click()
        expect(bom_frame.locator("div").filter(has_text=re.compile(r"^暂无数据$")).first).to_be_visible()

        # 打开导出对话框
        logger.info("点击导出按钮，打开导出对话框")
        expect(bom_frame.get_by_role("button", name="export 导出")).to_be_visible()
        bom_frame.get_by_role("button", name="export 导出").click()

        # 输入导出文件名（移除录制产生的多余重复按键和误操作）
        logger.info("输入导出文件名")
        export_input = bom_frame.get_by_role("dialog", name="导出").get_by_role("textbox")
        export_input.click()
        export_input.fill("FJ00002")
        expect(export_input).to_be_visible()

        # 确认导出
        logger.info("点击确认导出按钮")
        bom_frame.get_by_role("button", name="导 出").click()

        # 验证结果提示
        logger.info("验证未查询到可导出数据的提示信息")
        bom_frame.get_by_text("未查询到可导出的物料清单").click()
        expect(bom_frame.locator("div").filter(has_text="未查询到可导出的物料清单").nth(3)).to_be_visible()

        logger.info(f"用例export_nonexistent_product_material执行完成")
