        page.get_by_text("基础资料").click()
        page.get_by_text("编码规则配置").click()
        
        # 核心操作：选中目标规则，点击编辑后取消操作
        logger.info("执行编辑取消操作流程")
        content_frame = page.locator("iframe[name=\"supos-tab-framework-2\"]").content_frame
        content_frame.get_by_role("cell", name="AA00006").click()
        content_frame.locator("li:nth-child(4) > .ant-menu-title-content > .edit-btn").first.click()
        content_frame.get_by_role("button", name="取 消").click()
        
        logger.info(f"用例verify_enable_cancel_action执行完成")
