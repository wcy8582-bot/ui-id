import pytest
from playwright.sync_api import Page, expect
from src.base.base_test import BaseTest
from src.common.logger import logger

class TestVerifyEnableCancelAction(BaseTest):
    """
    用例名：verify_enable_cancel_action
    用例ms的id：0
    """

    def test_verify_enable_cancel_action(self, page: Page, project_name: str):
        f"""测试编码规则编辑取消功能
        用例名：verify_enable_cancel_action
        用例ms的id：0
        项目名：{project_name}

        Args:
            page: 页面实例
            project_name: 项目名称
        """
        logger.info("=" * 60)
        logger.info(f"开始执行用例：verify_enable_cancel_action")
        logger.info(f"用例ms的id：0")
        logger.info("=" * 60)
        
        # 使用公用登录方法
        self.login(page, project_name)
        logger.info("系统登录完成，开始进入目标功能页面")
        
        # 登录后确认进入系统主页
        logger.info("点击确定按钮进入系统主页")
        page.get_by_role("button", name="确定").click()
        
        # 导航到编码规则配置页面
