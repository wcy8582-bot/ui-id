from playwright.sync_api import Playwright, sync_playwright, expect


def run(playwright: Playwright) -> None:
    browser = playwright.chromium.launch(headless=False)
    context = browser.new_context(ignore_https_errors=True)
    page = context.new_page()
    page.goto("https://test2.saas-test3.supcon.com:32188/login#/login")
    page.get_by_role("textbox", name="请输入用户名").click()
    page.get_by_role("textbox", name="请输入用户名").fill("admin")
    page.get_by_role("textbox", name="请输入密码").click()
    page.get_by_role("textbox", name="请输入密码").click()
    page.get_by_role("textbox", name="请输入密码").fill("Supcon1304@")
    page.get_by_role("button", name="登 录").click()
    page.get_by_text("基础资料").click()
    page.get_by_text("物料清单").click()
    page.locator("iframe[name=\"supos-tab-framework-2\"]").content_frame.get_by_role("button", name="plus-circle 新增").click()
    expect(page.locator("iframe[name=\"supos-tab-framework-2\"]").content_frame.get_by_text("父项产品信息")).to_be_visible()
    expect(page.locator("iframe[name=\"supos-tab-framework-2\"]").content_frame.get_by_role("dialog", name="创建物料清单").locator("form")).to_be_visible()
    page.locator("iframe[name=\"supos-tab-framework-2\"]").content_frame.locator("div").filter(has_text=re.compile(r"^父项产品请选择产品$")).first.click()
    page.locator("iframe[name=\"supos-tab-framework-2\"]").content_frame.locator("#rc_select_3").click()
    page.locator("iframe[name=\"supos-tab-framework-2\"]").content_frame.get_by_role("button", name="保 存").click()
    page.locator("iframe[name=\"supos-tab-framework-2\"]").content_frame.locator("#combineValue_help").get_by_text("请选择产品").click()
    page.locator("iframe[name=\"supos-tab-framework-2\"]").content_frame.get_by_text("父项产品请选择产品请选择产品").click()
    expect(page.locator("iframe[name=\"supos-tab-framework-2\"]").content_frame.get_by_text("父项产品请选择产品请选择产品")).to_be_visible()
    page.close()

    # ---------------------
    context.close()
    browser.close()


with sync_playwright() as playwright:
    run(playwright)

