import pytest
from playwright.sync_api import Page, expect
from src.base.base_test import BaseTest
from src.common.logger import logger

class TestRequiredValidation(BaseTest):
    """
    用例名：required_validation
    用例ms的id：0
    """

    def test_required_validation(self, page: Page, project_name: str):
        f"""测试物料清单必填项校验
        用例名：required_validation
        用例ms的id：0
        项目名：{project_name}

        Args:
            page: 页面实例
            project_name: 项目名称
        """
        logger.info("=" * 60)
        logger.info(f"开始执行用例：required_validation")
        logger.info(f"用例ms的id：0")
        logger.info("=" * 60)
        
        # 使用封装好的公用登录方法登录系统
        self.login(page, project_name)
        
        # 进入基础资料下的物料清单模块
        logger.info("进入基础资料 -> 物料清单页面")
        page.get_by_text("基础资料").click()
        page.get_by_text("物料清单").click()
        
        # 获取物料清单模块iframe
        bom_frame = page.locator("iframe[name=\"supos-tab-framework-2\"]").content_frame
        
        # 点击新增按钮打开创建弹窗
        logger.info("点击新增按钮，打开创建物料清单弹窗")
        bom_frame.get_by_role("button", name="plus-circle 新增").click()
        
        # 断言弹窗正常打开
        logger.info("断言创建弹窗元素可见")
        expect(bom_frame.get_by_text("父项产品信息")).to_be_visible()
        expect(bom_frame.get_by_role("dialog", name="创建物料清单").locator("form")).to_be_visible()
        
        # 不选择父项产品直接点击保存，触发必填校验
        logger.info("触发必填校验：未选择父项产品直接点击保存")
        bom_frame.locator("div").filter(has_text=re.compile(r"^父项产品请选择产品$")).first.click()
        bom_frame.locator("#rc_select_3").click()
        bom_frame.get_by_role("button", name="保 存").click()
        
        # 断言必填校验提示正确显示
        logger.info("断言必填校验提示信息正确显示")
        bom_frame.locator("#combineValue_help").get_by_text("请选择产品").click()
        bom_frame.get_by_text("父项产品请选择产品请选择产品").click()
        expect(bom_frame.get_by_text("父项产品请选择产品请选择产品")).to_be_visible()
        
        logger.info("用例required_validation执行完成")
