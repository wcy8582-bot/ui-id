from playwright.sync_api import Playwright, sync_playwright, expect


def run(playwright: Playwright) -> None:
    browser = playwright.chromium.launch(headless=False)
    context = browser.new_context(ignore_https_errors=True)
    page = context.new_page()
    page.goto("https://test2.saas-test3.supcon.com:32188/login#/login")
    page.get_by_role("textbox", name="请输入用户名").click()
    page.get_by_role("textbox", name="请输入用户名").fill("admin")
    page.get_by_role("textbox", name="请输入密码").click()
    page.get_by_role("textbox", name="请输入密码").fill("Supcon1304@")
    page.get_by_role("button", name="登 录").click()
    page.get_by_role("button", name="确定").click()
    page.get_by_text("基础资料").click()
    page.get_by_text("编码规则配置").click()
    page.locator("iframe[name=\"supos-tab-framework-2\"]").content_frame.get_by_role("listitem", name="2").locator("a").click()
    page.locator("iframe[name=\"supos-tab-framework-2\"]").content_frame.get_by_role("cell", name="AA0002").first.click()
    page.locator("iframe[name=\"supos-tab-framework-2\"]").content_frame.locator(".ant-table-cell.ant-table-cell-fix-right.ant-table-cell-fix-right-first.ant-table-cell-row-hover > .ant-menu-overflow > li > .ant-menu-title-content > .edit-btn").first.click()
    page.locator("iframe[name=\"supos-tab-framework-2\"]").content_frame.get_by_role("button", name="返 回").click()
    page.close()

    # ---------------------
    context.close()
    browser.close()


with sync_playwright() as playwright:
    run(playwright)

