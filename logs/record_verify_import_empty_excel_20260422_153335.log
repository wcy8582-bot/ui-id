import pytest
from playwright.sync_api import Page, expect
from src.base.base_test import BaseTest
from src.common.logger import logger

class TestVerifyImportEmptyExcel(BaseTest):
    """
    用例名：verify_import_empty_excel
    用例ms的id：0
    """

    def test_verify_import_empty_excel(self, page: Page, project_name: str):
        f"""测试物料清单Excel导入功能
        用例名：verify_import_empty_excel
        用例ms的id：0
