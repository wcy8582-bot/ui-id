import pytest
from playwright.sync_api import Page, expect
from src.base.base_test import BaseTest
from src.common.logger import logger


class TestVerifyBomListColumns(BaseTest):
    """
    用例名：verify_bom_list_columns
    用例ms的id：0
    """

    def test_verify_bom_list_columns(self, page: Page, project_name: str):
        f"""验证物料清单列表列展示功能
        用例名：verify_bom_list_columns
        用例ms的id：0
        项目名：{project_name}

        Args:
            page: 页面实例
            project_name: 项目名称
        """
        logger.info("=" * 60)
        logger.info(f"开始执行用例：verify_bom_list_columns")
        logger.info(f"用例ms的id：0")
        logger.info("=" * 60)
        
        # 使用封装好的公用登录方法
        logger.info("完成系统登录")
        self.login(page, project_name)
        
        # 导航进入物料清单页面
        logger.info("导航进入物料清单模块")
        page.get_by_text("基础资料").click()
        page.get_by_text("物料清单").click()
        
        # 复用iframe实例，减少重复定位
        bom_frame = page.locator("iframe[name=\"supos-tab-framework-2\"]").content_frame
        
        # 核心操作：触发列排序操作
        logger.info("执行列头点击排序操作")
        bom_frame.locator(".ant-table-container").click()
        bom_frame.get_by_role("columnheader", name="创建时间").click()
        bom_frame.get_by_role("columnheader", name="更新人").click()
        bom_frame.get_by_role("columnheader", name="创建人").click()
        
        # 验证列头可见性
        logger.info("验证所有目标列头正常展示")
        expect(bom_frame.get_by_role("columnheader", name="创建人")).to_be_visible()
        expect(bom_frame.get_by_role("columnheader", name="创建时间")).to_be_visible()
        expect(bom_frame.get_by_role("columnheader", name="更新人")).to_be_visible()
        
        logger.info("用例verify_bom_list_columns执行完成")
